+/**
+  Page through the previous boot's text on the panel.
+
+  The two-window echo above shows the first lines and the last lines, which is all that fits
+  in one photograph. The rest of the kernel log was only reachable over USB - and that needs
+  the vendor function stack, which does not survive on this board. So the same text is offered
+  one page at a time: Volume Up prints the next page, Volume Down (or the timeout) continues
+  the boot. A camera then captures the whole log, not a window of it.
+**/
+STATIC
+UINTN
+PanelPrintPage (
+  IN UINTN  StartLine,
+  IN UINTN  Lines
+  )
+{
+  UINTN  Line;
+  UINTN  Offset;
+  UINTN  Printed;
+
+  Offset  = 0;
+  Line    = 0;
+  Printed = 0;
+  while ((Offset < mLogLen) && (Line < StartLine)) {
+    if (mLog[Offset] == '\n') {
+      Line++;
+    }
+
+    Offset++;
+  }
+
+  while ((Offset < mLogLen) && (Printed < Lines)) {
+    DEBUG ((DEBUG_WARN, "%a", &mLog[Offset]));
+    while ((Offset < mLogLen) && (mLog[Offset] != '\n')) {
+      Offset++;
+    }
+
+    if (Offset < mLogLen) {
+      Offset++;
+    }
+
+    Printed++;
+  }
+
+  return Printed;
+}
+
+STATIC
+VOID
+DumpPagedLog (
+  IN UINT32  HoldSeconds
+  )
+{
+  UINTN    StartLine;
+  UINTN    Page;
+  UINTN    Lines;
+  UINT32   Remaining;
+  BOOLEAN  NextPage;
+
+  StartLine = 0;
+  Page      = 1;
+  for (;;) {
+    DEBUG ((DEBUG_WARN, "--- boot log page %u (vol-up next, vol-down continue) ---\n", Page));
+    Lines = PanelPrintPage (StartLine, 22);
+    StartLine += Lines;
+    if (Lines < 22) {
+      return;
+    }
+
+    gBS->Stall (200 * 1000);
+
+    NextPage  = FALSE;
+    Remaining = (HoldSeconds == 0) ? 20 : HoldSeconds;
+    while (Remaining > 0) {
+      EFI_INPUT_KEY  Key;
+
+      UkeWatchdogPet (NULL);
+      if ((gST->ConIn != NULL) && (gST->ConIn->ReadKeyStroke != NULL)) {
+        while (!EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) {
+          if (Key.ScanCode == SCAN_DOWN) {
+            return;
+          }
+
+          if (Key.ScanCode == SCAN_UP) {
+            NextPage = TRUE;
+          }
+        }
+      }
+
+      if (NextPage) {
+        break;
+      }
+
+      gBS->Stall (20 * 1000);
+      Remaining--;
+    }
+
+    if (!NextPage) {
+      return;
+    }
+
+    Page++;
+  }
+}
