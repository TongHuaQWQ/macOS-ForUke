+#define UKE_QUD_DWC3_BASE         0x0A600000
+#define UKE_QUD_GCC_BCR           0x39000
+#define UKE_QUD_GCC_GDSCR         0x39004
+#define UKE_QUD_GCC_CFG_GDSCR     0x39008
+#define UKE_QUD_DWC3_GCTL         0xC110
+#define UKE_QUD_DWC3_GSNPSID      0xC120
+#define UKE_QUD_DWC3_GUSB2PHYCFG  0xC200
+#define UKE_QUD_DWC3_DCFG         0xC700
+#define UKE_QUD_DWC3_DCTL         0xC704
+#define UKE_QUD_DWC3_DSTS         0xC70C
+#define UKE_QUD_DCTL_RUN_STOP     (1U << 31)
+#define UKE_QUD_DSTS_DEVCTRLHLT   (1U << 22)
+#define UKE_QUD_CFG_GDSCR_POWER_UP_COMPLETE  (1U << 16)
+#define UKE_QUD_CBCR_COUNT        5
+#define UKE_QUD_CBCR_REQUIRED     3   /* eUSB2 only: the two SuperSpeed branches stay off */
+#define UKE_QUD_CBCR_CLK_OFF      (1U << 31)
