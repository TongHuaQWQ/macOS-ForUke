+/**
+  Print a printable run out of one 64-byte slot in the pram window.
+
+  The kernel-side probe leaves its breadcrumbs in the pram window (uke_usb writes
+  UKEUSB-STARTUP-ENTERED and UKEUSB-STEP-nnn at +0x1000, UkeLastLog uses +0x1100), and the whole
+  window scan above only reports them if they happen to survive as a long enough run. Reading the
+  slot directly turns "did a kernel STARTUP from that archive run at all" into one line on the
+  panel, with no thresholds in the way.
+**/
+STATIC
+VOID
+LogPramSlot (
+  IN CONST UINT8  *Pram,
+  IN UINTN         Size,
+  IN UINTN         Offset
+  )
+{
+  CHAR8  Text[49];
+  UINTN  Index;
+  UINTN  Copied;
+
+  if (Offset + 64 > Size) {
+    return;
+  }
+
+  Copied = 0;
+  for (Index = 0; (Index < 48) && (Pram[Offset + Index] >= 0x20) && (Pram[Offset + Index] < 0x7f); Index++) {
+    Text[Copied++] = (CHAR8)Pram[Offset + Index];
+  }
+
+  Text[Copied] = '\0';
+  if (Copied == 0) {
+    Log ("pram slot 0x%lx: <no printable text>", Offset);
+  } else {
+    Log ("pram slot 0x%lx: \"%a\"", Offset, Text);
+  }
+}
+
+
+/**
+  Raw hex of one 64-byte slot: if the kernel wrote something that is not printable text (a partial
+  record, a differently aligned write), hex is the only way to see it at all.
+**/
+STATIC
+VOID
+LogPramSlotRaw (
+  IN CONST UINT8  *Pram,
+  IN UINTN         Size,
+  IN UINTN         Offset
+  )
+{
+  if (Offset + 16 > Size) {
+    return;
+  }
+
+  Log (
+       "pram slot 0x%lx raw: %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x",
+       Offset,
+       Pram[Offset], Pram[Offset + 1], Pram[Offset + 2], Pram[Offset + 3],
+       Pram[Offset + 4], Pram[Offset + 5], Pram[Offset + 6], Pram[Offset + 7],
+       Pram[Offset + 8], Pram[Offset + 9], Pram[Offset + 10], Pram[Offset + 11],
+       Pram[Offset + 12], Pram[Offset + 13], Pram[Offset + 14], Pram[Offset + 15]
+       );
+}
+
+/**
+  Find a literal marker anywhere in the window.
+
+  The kernel is expected to write UKEUSB-* at +0x1000, but an offset that is off by a page, a
+  mapping that landed elsewhere or a record written by a different path all render the fixed slots
+  useless. Searching the whole window for the marker itself removes that assumption: every hit is
+  reported with its offset and the text that follows.
+**/
+STATIC
+VOID
+LogPramFind (
+  IN CONST UINT8  *Pram,
+  IN UINTN         Size,
+  IN CONST CHAR8  *Marker
+  )
+{
+  UINTN  Length;
+  UINTN  Offset;
+  UINTN  Found;
+  UINTN  Index;
+  UINTN  Copied;
+  CHAR8  Text[41];
+
+  Length = AsciiStrLen (Marker);
+  Found  = 0;
+  for (Offset = 0; (Offset + Length <= Size) && (Found < 4); Offset++) {
+    if (CompareMem (&Pram[Offset], Marker, Length) != 0) {
+      continue;
+    }
+
+    Copied = 0;
+    for (Index = 0; (Index < 40) && ((Offset + Index) < Size); Index++) {
+      UINT8  Byte = Pram[Offset + Index];
+      if ((Byte < 0x20) || (Byte >= 0x7f)) {
+        break;
+      }
+      Text[Copied++] = (CHAR8)Byte;
+    }
+    Text[Copied] = '\0';
+    Log ("pram find \"%a\" at 0x%lx: \"%a\"", Marker, Offset, Text);
+    Found++;
+  }
+
+  if (Found == 0) {
+    Log ("pram find \"%a\": not present in %u KiB", Marker, (UINTN)(Size / 1024));
+  }
+}
