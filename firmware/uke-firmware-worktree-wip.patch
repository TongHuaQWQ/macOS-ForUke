+/**
+  Report, and optionally stop, the USB controller this firmware is about to hand
+  to the kernel.
+
+  Two questions are answered here, both of which used to need a device round to
+  guess at:
+
+    * did the vendor USB stack manage to power the GDSC, ungate the USB clocks,
+      de-assert the reset and reach a live DWC3, i.e. is the state XNU's
+      QcomUsbQualify accepts even present?
+    * is the controller left running (DCTL.RUN_STOP set, DSTS.DEVCTRLHLT clear)?
+      The qualifier refuses that state, and the firmware stack has no
+      ExitBootServices hook of its own, so the halt has to happen here.
+
+  Nothing outside the GCC window is read until the power domain and the three
+  required USB branches are proven live.
+**/
+STATIC
+VOID
+UkeUsbInheritProbe (
+  IN BOOLEAN  Halt
+  )
+{
+  UINT32   Cbcr[UKE_QUD_CBCR_COUNT];
+  UINT32   Bcr;
+  UINT32   Gdscr;
+  UINT32   CfgGdscr;
+  UINT32   Gsnpsid;
+  UINT32   Gctl;
+  UINT32   PhyCfg;
+  UINT32   Dcfg;
+  UINT32   Dctl;
+  UINT32   Dsts;
+  UINTN    Index;
+  UINTN    ClocksRunning;
+  UINTN    Poll;
+  BOOLEAN  Powered;
+
+  for (Index = 0; Index < UKE_QUD_CBCR_COUNT; Index++) {
+    Cbcr[Index] = MmioRead32 (UKE_QUD_GCC_BASE + mQudCbcrOffset[Index]);
+  }
+
+  Bcr      = MmioRead32 (UKE_QUD_GCC_BASE + UKE_QUD_GCC_BCR);
+  Gdscr    = MmioRead32 (UKE_QUD_GCC_BASE + UKE_QUD_GCC_GDSCR);
+  CfgGdscr = MmioRead32 (UKE_QUD_GCC_BASE + UKE_QUD_GCC_CFG_GDSCR);
+
+  Log ("UKE-QUD: gcc bcr=%08x gdscr=%08x cfg_gdscr=%08x", Bcr, Gdscr, CfgGdscr);
+  Log (
+       "UKE-QUD: cbcr %08x %08x %08x %08x %08x",
+       Cbcr[0], Cbcr[1], Cbcr[2], Cbcr[3], Cbcr[4]
+       );
+
+  Powered = (CfgGdscr & UKE_QUD_CFG_GDSCR_POWER_UP_COMPLETE) != 0;
+  ClocksRunning = 0;
+  for (Index = 0; Index < UKE_QUD_CBCR_REQUIRED; Index++) {
+    if ((Cbcr[Index] & UKE_QUD_CBCR_CLK_OFF) == 0) {
+      ClocksRunning++;
+    }
+  }
+
+  if (!Powered || ((Bcr & 1U) != 0) || (ClocksRunning < UKE_QUD_CBCR_REQUIRED)) {
+    Log (
+         "UKE-QUD: NOT INHERITABLE pwr=%u rst_deasserted=%u clocks=%u/%u (DWC3 not touched)",
+         (UINTN)(Powered ? 1 : 0),
+         (UINTN)((Bcr & 1U) ? 0 : 1),
+         ClocksRunning,
+         (UINTN)UKE_QUD_CBCR_REQUIRED
+         );
+
+    //
+    // Still worth a look when the power is on but a clock is gated: the core is
+    // readable then, and a silent GSNPSID answers "wrong base address" instead of
+    // "no power".
+    //
+    if (!Powered || ((Bcr & 1U) != 0)) {
+      return;
+    }
+  }
+
+  Gsnpsid = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_GSNPSID);
+  Gctl    = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_GCTL);
+  PhyCfg  = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_GUSB2PHYCFG);
+  Dcfg    = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DCFG);
+  Dctl    = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DCTL);
+  Dsts    = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DSTS);
+
+  Log ("UKE-QUD: dwc3 gsnpsid=%08x gctl=%08x phycfg=%08x", Gsnpsid, Gctl, PhyCfg);
+  Log (
+       "UKE-QUD: dwc3 dcfg=%08x dctl=%08x dsts=%08x run_stop=%u halted=%u",
+       Dcfg,
+       Dctl,
+       Dsts,
+       (UINTN)((Dctl & UKE_QUD_DCTL_RUN_STOP) ? 1 : 0),
+       (UINTN)((Dsts & UKE_QUD_DSTS_DEVCTRLHLT) ? 1 : 0)
+       );
+
+  if (!Halt) {
+    return;
+  }
+
+  if ((Dctl & UKE_QUD_DCTL_RUN_STOP) != 0) {
+    MmioWrite32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DCTL, Dctl & ~UKE_QUD_DCTL_RUN_STOP);
+  }
+
+  Dsts = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DSTS);
+  for (Poll = 0; (Poll < 200) && ((Dsts & UKE_QUD_DSTS_DEVCTRLHLT) == 0); Poll++) {
+    gBS->Stall (1000);
+    Dsts = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DSTS);
+  }
+
+  Dctl = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DCTL);
+  Log (
+       "UKE-QUD: halt %u ms dctl=%08x dsts=%08x halted=%u",
+       Poll,
+       Dctl,
+       Dsts,
+       (UINTN)(((Dctl & UKE_QUD_DCTL_RUN_STOP) == 0) &&
+               ((Dsts & UKE_QUD_DSTS_DEVCTRLHLT) != 0) ? 1 : 0)
+       );
+}
+
+/**
+  ExitBootServices: repeat the halt with the CPU to ourselves. The vendor USB
+  stack keeps its own timers until boot services end, so a RUN_STOP cleared at
+  ReadyToBoot can be set again before the kernel starts.
+**/
+STATIC
+VOID
+EFIAPI
+UkeUsbHaltOnExitBootServices (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  UINT32  Dctl;
+
+  Dctl = MmioRead32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DCTL);
+  if ((Dctl & UKE_QUD_DCTL_RUN_STOP) != 0) {
+    MmioWrite32 (UKE_QUD_DWC3_BASE + UKE_QUD_DWC3_DCTL, Dctl & ~UKE_QUD_DCTL_RUN_STOP);
+  }
+}
