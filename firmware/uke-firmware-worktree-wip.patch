+/**
+  Publish this firmware's log as a Linux ramoops console record.
+
+  The USB log disk needs the vendor function stack, which does not survive on this board
+  yet, so the log had no way out that did not involve photographing the panel. Android,
+  however, maps the ramoops region described by its own device tree
+
+      ramoops_mem: ramoops_region { reg = <0x00 0xa7000000 0x00 0x400000>;
+                                    console-size = <0x200000>; pmsg-size = <0x200000>; }
+
+  and pstore reads the *previous* boot's console zone out of it on the next start. The
+  frame buffer volume occupies 0xA7100000 and up, so the first megabyte of that zone is
+  free for this firmware. A record is a persistent_ram_buffer header (sig "DBRG", start,
+  size) followed by the text; pstore hands it to userspace as /sys/fs/pstore/... .
+
+  With a root adb shell that turns a failed boot into a readable log:
+
+      adb shell su -c 'ls -l /sys/fs/pstore/'
+      adb shell su -c 'cat /sys/fs/pstore/dmesg-ramoops-0'
+
+  Only the text this driver keeps is copied, and the window is written back before the
+  hand-off so a reset cannot leave it in the cache.
+**/
+STATIC
+VOID
+UkeRamoopsPublish (
+  VOID
+  )
+{
+  EFI_STATUS                       Status;
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR  Descriptor;
+  UINT64                           Base;
+  UINT64                           Size;
+  UINT32                           Capacity;
+  UINTN                            Copy;
+  volatile UINT32                  *Header;
+  CHAR8                            *Data;
+
+  Base     = PcdGet64 (PcdUkeRamoopsBase);
+  Capacity = PcdGet32 (PcdUkeRamoopsSize);
+  if ((Base == 0) || (Capacity < 4096)) {
+    return;
+  }
+
+  Status = gDS->GetMemorySpaceDescriptor ((EFI_PHYSICAL_ADDRESS)Base, &Descriptor);
+  if (EFI_ERROR (Status)) {
+    Log ("ramoops: 0x%lx not described %r", Base, Status);
+    return;
+  }
+
+  Size = (mLogLen < (Capacity - 32)) ? mLogLen : (Capacity - 32);
+  if (Size == 0) {
+    return;
+  }
+
+  Header    = (volatile UINT32 *)(UINTN)Base;
+  Data      = (CHAR8 *)(UINTN)(Base + sizeof (UKE_RAMOOPS_HEADER));
+  Copy      = (UINTN)Size;
+
+  Log ("ramoops: publishing %u of %u bytes at 0x%lx", Copy, mLogLen, Base);
+  CopyMem (Data, mLog, Copy);
+  Header[0] = UKE_RAMOOPS_SIG;
+  Header[1] = 0;              /* start: this is a single record, not a ring */
+  Header[2] = (UINT32)Copy;   /* size */
+  WriteBackDataCacheRange ((VOID *)(UINTN)Base, (UINTN)sizeof (UKE_RAMOOPS_HEADER) + Copy);
+  Log ("ramoops: written back");
+}
