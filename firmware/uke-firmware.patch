+  // is FD content. The one page that no region covered (0xA7600000-0xA7601000) is mapped here: the
+  // b56 device round faulted with SP = 0xA7600F20 and FAR = 0xA7600F30, a write into exactly that
+  // hole, so an unmapped stray page below the stack turns a deep call chain into a data abort with
+  // no log at all.
+  {"FD Tail", 0xA7600000, 0x00001000, AddMem, SYS_MEM, SYS_MEM_CAP, BsData, WRITE_BACK_XN},
+  {"Info Blk", 0xA7601000, 0x00001000, AddMem, SYS_MEM, SYS_MEM_CAP, RtData, WRITE_BACK_XN},
+  {"MMU PageTables", 0xA7602000, 0x00003000, AddMem, SYS_MEM, SYS_MEM_CAP, BsData, WRITE_BACK_XN},
+  {"Log Buffer", 0xA7605000, 0x00008000, AddMem, SYS_MEM, SYS_MEM_CAP, RtData, WRITE_BACK_XN},
+  // 1 MiB, not the project-wide 256 KiB: the vendor fleet (clock, PMIC, NPA, UFS, USB function)
+  // took the stack past 300 KiB on the device, which is what the b56 fault above recorded.
+  {"UEFI Stack", 0xA760D000, 0x00100000, AddMem, SYS_MEM, SYS_MEM_CAP, BsData, WRITE_BACK_XN},
+  {"SEC Heap", 0xA770D000, 0x0008C000, AddMem, SYS_MEM, SYS_MEM_CAP, BsData, WRITE_BACK_XN},
+  {"Sched Heap", 0xA7799000, 0x00400000, AddMem, SYS_MEM, SYS_MEM_CAP, BsData, WRITE_BACK_XN},
+  {"FV Region", 0xA7B99000, 0x00400000, AddMem, SYS_MEM, SYS_MEM_CAP, BsData, WRITE_BACK_XN},
+  {"UEFI RESV", 0xA7F99000, 0x00127000, AddMem, SYS_MEM, SYS_MEM_CAP, BsData, WRITE_BACK_XN},
+  {"DXE Heap", 0xA80C0000, 0x09F40000, AddMem, SYS_MEM, SYS_MEM_CAP, Conv, WRITE_BACK_XN},
+  // The ABL's initrd lands in the middle of the 2-3 GiB hole and must not be handed to the DXE
+  // allocator. This unit's own /chosen says where it is:
+  //     linux,initrd-start = 0xB5CF2000   linux,initrd-end = 0xB7FFEDAC
+  // (work/analysis/ref/dt/live.dts:26-27), and the upstream uke device record measured the same
+  // hazard as "live ABL initrd 0xB2D51000..0xB7FFF41C overlaps the former DXE Heap
+  // 0xA8000000..0xC3A00000", fixing it by reserving the handoff before SEC/DXE and moving the heap
+  // (unixnu-docs/upstream-docs/docs/zh/devices/uke.md §固件与启动). Both units place the ramdisk so
+  // that it ends at 0xB8000000, so one 96 MiB reservation covers either.
+  //
+  // The heap is therefore two runs with this hole between them rather than one run that silently
+  // contains it. Losing allocator space costs nothing here: the FD is 5 MiB.
+  {"ABL initrd handoff", 0xB2000000, 0x06000000, AddMem, MEM_RES, UNCACHEABLE, Reserv, UNCACHED_UNBUFFERED_XN},
+  // 0xB8000000-0xBAB00000 is left unmapped on purpose: the upstream record's fix starts its heap at
+  // 0xBAB00000, and there is no evidence this board needs those 43 MiB.
+  {"DXE Heap high", 0xBAB00000, 0x08F00000, AddMem, SYS_MEM, SYS_MEM_CAP, Conv, WRITE_BACK_XN},
+  // High DRAM banks from the live DT /memory reg (uke-live.dtb, 12 GB device): the SM7675 puts most
+  // RAM above 4 GiB exactly like SM8550, and the two ranges are physically adjacent, so DarwinBoot's
+  // RunEnd merges them into one 9 GiB conventional run (0x8C0000000..0xB00000000). Declared statically
+  // the sheng way (uefi-sheng MemoryMapLib "DRAM bank 1 low/high"), because gDS->AddMemorySpace in
+  // UkeBootMemoryDxe cannot map ranges outside the SEC page tables (its ADD_BELOW = SIZE_4GB).
+  // 0x880000000/0x8B0000000/0x8B8100000 pieces are left out until the big run is validated.
+  // 8 GB SKU: the high run is 0x8C0000000 + 0x140000000 (5 GiB, ends exactly at 0xA0000000) per this unit's
+  // /memory reg. The 12 GB reference had two adjacent banks (0x8C0000000+0xC0000000 and 0x980000000+0x180000000)
+  // merging into 9 GiB; mapping that much here would hand the allocator DRAM that does not exist below
+  // 0xA0000000 and abort on first touch. Keep one bank until the kernel proves it needs the fragments
+  // (0x880000000+0x2FB00000, 0x8B0000000+0x9F00000, 0x8BA100000+0x1E00000).
+  {"DRAM bank high 0x8C0000000", 0x8C0000000, 0x140000000, AddMem, SYS_MEM, SYS_MEM_CAP, Conv, WRITE_BACK_XN},
+  {"IMEM Base", 0x14680000, 0x0002A000, NoHob, MMAP_IO, INITIALIZED, Conv, NS_DEVICE},
+  {"IMEM Cookie Base", 0x146AA000, 0x00016000, AddDev, MMAP_IO, INITIALIZED, Conv, NS_DEVICE},
+  {"IPC_ROUTER_TOP", 0x00400000, 0x00100000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  // GCC (live DT: gcc: clock-controller@100000, reg <0x100000 0x1f4200>) was missing
+  // from this map even though the vendor ClockDxe and UkeUsbLogDxe's USB hand-off
+  // probe both read it, and an unmapped read is a data abort with no log line.
+  {"GCC", 0x00100000, 0x00200000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"SECURITY CONTROL", 0x00780000, 0x00007000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"QUP", 0x00800000, 0x00300000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"PRNG_CFG_PRNG", 0x010C0000, 0x0000C000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"CRYPTO0 CRYPTO", 0x01DC0000, 0x00040000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"CORE_TOP_CSR", 0x01F00000, 0x00100000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  // GFX: the whole 0x03D00000-aperture in one entry, deliberately not split. The live device tree
+  // puts every GPU-side block inside these 1 MiB: the KGSL register block starts at 0x3d00000
+  // (reg <0x3d00000 0x40000 0x3d50000 0x10000 0x3d61000 0x800 0x3d9e000 0x1000 ...>,
+  // live.dts:13682), GPUCC at 0x3d90000 + 0xa000 (:13396) and the GPU SMMU at 0x3da0000 + 0x40000
+  // plus 0x3de6000 (:15235) with two more pages at 0x3de8000/0x3dec000 (:15255).
+  //
+  // Why one entry matters: the vendor ClockDxe takes its GPUCC base from this registration, and a
+  // board that exposed GPUCC/CPR/GPU-SMMU as separate partial ranges had the whole registration
+  // rejected, leaving that base unset -- "partial GPUCC/CPR/SMMU resource HOBs made that whole-region
+  // registration fail and left the ClockDxe GPUCC base unset. The board now exposes one complete GFX
+  // Device MMIO region" (unixnu-docs/upstream-docs/docs/devices/oneplus13t.md:270).
+  // ClockDxe is off in this build (Include/DXE.inc), so this is a prerequisite for turning it back
+  // on, not a fix with an effect today; the KGSL ranges outside this aperture (0x10048000,
+  // 0x10900000, 0x10b05000) still need their own entries before any GPU driver runs under UEFI.
+  {"GFX", 0x03D00000, 0x00100000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"PERIPH_SS", 0x08800000, 0x00100000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"USB", 0x0A600000, 0x00200000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"AOSS", 0x0B000000, 0x04000000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"TLMM", 0x0F000000, 0x01000000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"SMMU", 0x15000000, 0x00200000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+  {"APSS_HM", 0x17000000, 0x02000000, AddDev, MMAP_IO, UNCACHEABLE, MmIO, NS_DEVICE},
+};
+
+VOID
+GetMemoryMap (
+  OUT EFI_MEMORY_REGION_DESCRIPTOR **MemoryDescriptor,
+  OUT UINT8                         *MemoryDescriptorCount
+  )
+{
+  *MemoryDescriptor      = gMemoryDescriptor;
+  *MemoryDescriptorCount = ARRAY_SIZE (gMemoryDescriptor);
+}
