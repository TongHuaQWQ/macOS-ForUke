+## @file
+#  uke USB log channel: expose a RAM log disk (and the UFS LUNs) over the
+#  DWC3 function controller, so the host can read the boot log as a disk.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+[Defines]
+  INF_VERSION                    = 0x0001001B
+  BASE_NAME                      = UkeUsbLogDxe
+  FILE_GUID                      = 7E3A5B2C-4D6F-4A8B-9C1D-2E3F4A5B6C80
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = UkeUsbLogDxeEntry
+
+[Sources]
+  UkeUsbLogDxe.c
+
+[Packages]
+  MdePkg/MdePkg.dec
+  ukePkg/uke.dec
+
+[LibraryClasses]
+  BaseLib
+  BaseMemoryLib
+  DevicePathLib
+  DebugLib
+  DxeServicesTableLib
+  PcdLib
+  UefiBootServicesTableLib
+  UefiDriverEntryPoint
+  UefiLib
+
+[Protocols]
+  gEfiBlockIoProtocolGuid                       ## PRODUCES
+  gEfiDevicePathProtocolGuid                    ## PRODUCES
+
+[Pcd]
+  gUkePkgTokenSpaceGuid.PcdUkeUsbLogHoldSeconds
+  gUkePkgTokenSpaceGuid.PcdUkePramBase
+  gUkePkgTokenSpaceGuid.PcdUkePramSize
+
+[Guids]
+  gEfiEventReadyToBootGuid                      ## CONSUMES
+
+[Depex]
+  TRUE
