diff --git a/Platforms/Xiaomi/ukePkg/Tools/gen-vendor-binaries.py b/Platforms/Xiaomi/ukePkg/Tools/gen-vendor-binaries.py
new file mode 100644
index 00000000..2c19111a
--- /dev/null
+++ b/Platforms/Xiaomi/ukePkg/Tools/gen-vendor-binaries.py
@@ -0,0 +1,176 @@
+#!/usr/bin/env python3
+"""Generate Binaries/uke/QcomPkg from the stock uke UEFI image.
+
+The stock `uefi_a.img` on the tablet carries the vendor DXE fleet that this
+platform's DSC/FDF expect under `Binaries/uke/QcomPkg/Drivers/...`. The device
+submodule ships only `RawFiles` for uke, so the vendor side has to be extracted
+from the firmware the tablet actually shipped with.
+
+Source of truth: `work/analysis/ref/vendor-dxe/`, produced by
+
+    work/analysis/.venv-fw/bin/python work/analysis/fw-extract-mods.py \
+        work/tablet-backup-20261103/images/uefi_a.img \
+        work/analysis/ref/vendor-dxe
+
+which writes one `<UID name>.efi` (+ `.depex` when the FFS file has a DEPEX
+section) per module plus `manifest.json`. This script maps those UI names onto
+the paths `uke.dsc` / `uke.fdf` / `Include/{APRIORI,DXE}.inc` reference, copying
+the PE32 and DEPEX unchanged and keeping the stock FFS FILE_GUID so the image
+identity matches the firmware the device was validated with.
+
+Usage:
+    python3 Platforms/Xiaomi/ukePkg/Tools/gen-vendor-binaries.py \
+        [--source DIR] [--dest DIR] [--check]
+"""
+
+import argparse
+import json
+import re
+import shutil
+import sys
+from pathlib import Path
+
+# Directory/INF as referenced by the platform's include files -> stock UI name.
+# Keep this in the same order as DXE.inc/APRIORI.inc so a diff is readable.
+MODULES = [
+    ("EnvDxe/EnvDxe.inf", "EnvDxeEnhanced"),
+    ("SmemDxe/SmemDxe.inf", "SmemDxe"),
+    ("DALSYSDxe/DALSYSDxe.inf", "DALSys"),
+    ("HWIODxe/HWIODxe.inf", "HWIODxeDriver"),
+    ("ChipInfoDxe/ChipInfoDxe.inf", "ChipInfo"),
+    ("PlatformInfoDxe/PlatformInfoDxe.inf", "PlatformInfoDxeDriver"),
+    ("ProjectInfoDxe/ProjectInfoDxe.inf", "ProjectInfoDxe"),
+    ("HALIOMMUDxe/HALIOMMUDxe.inf", "HALIOMMU"),
+    ("ULogDxe/ULogDxe.inf", "ULogDxe"),
+    ("IPCCDxe/IPCCDxe.inf", "IPCCDxe"),
+    ("GLinkDxe/GLinkDxe.inf", "GlinkDxe"),
+    ("CmdDbDxe/CmdDbDxe.inf", "CmdDbDxe"),
+    ("PwrUtilsDxe/PwrUtilsDxe.inf", "PwrUtilsDxe"),
+    ("NpaDxe/NpaDxe.inf", "NpaDxe"),
+    ("RpmhDxe/RpmhDxe.inf", "RpmhDxe"),
+    ("VcsDxe/VcsDxe.inf", "VcsDxe"),
+    ("ClockDxe/ClockDxe.inf", "ClockDxe"),
+    ("ICBDxe/ICBDxe.inf", "ICBDxe"),
+    ("ShmBridgeDxe/ShmBridgeDxeLA.inf", "ShmBridgeDxeLA"),
+    ("TzDxe/ScmDxeCompat.inf", "ScmDxeCompat"),
+    ("TzDxe/TzDxeLA.inf", "TzDxeLA"),
+    ("TLMMDxe/TLMMDxe.inf", "DALTLMM"),
+    ("I2CDxe/I2CDxe.inf", "I2C"),
+    ("SPMIDxe/SPMIDxe.inf", "SPMI"),
+    ("PmicDxe/PmicDxeLa.inf", "PmicDxe"),
+    ("SdccDxe/SdccDxe.inf", "SdccDxe"),
+    ("UFSDxe/UFSDxe.inf", "UFSDxe"),
+    ("DDRInfoDxe/DDRInfoDxe.inf", "DDRInfoDxe"),
+    ("FeatureEnablerDxe/FeatureEnablerDxe.inf", "FeatureEnablerDxe"),
+    ("PILProxyDxe/PILProxyDxe.inf", "PILProxyDxe"),
+    ("PILDxe/PILDxe.inf", "PILDxe"),
+    ("SPSSDxe/SPSSDxe.inf", "SPSSDxe"),
+    ("SPIDxe/SPIDxe.inf", "SPI"),
+    ("PmicGlinkDxe/PmicGlinkDxe.inf", "PmicGlinkDxe"),
+    ("UsbPwrCtrlDxe/UsbPwrCtrlDxe.inf", "UsbPwrCtrlDxe"),
+    ("QcomChargerDxe/QcomChargerDxeLA.inf", "QcomChargerDxeLA"),
+    ("ChargerExDxe/ChargerExDxe.inf", "ChargerExDxe"),
+    ("UsbfnDwc3Dxe/UsbfnDwc3Dxe.inf", "UsbfnDwc3Dxe"),
+    ("UsbMsdDxe/UsbMsdDxe.inf", "UsbMsdDxe"),
+    ("UsbDeviceDxe/UsbDeviceDxe.inf", "UsbDeviceDxe"),
+    ("UsbConfigDxe/UsbConfigDxe.inf", "UsbConfigDxe"),
+    ("UsbInitDxe/UsbInitDxe.inf", "UsbInitDxe"),
+    ("ButtonsDxe/ButtonsDxe.inf", "ButtonsDxe"),
+    ("TsensDxe/TsensDxe.inf", "TsensDxe"),
+    ("LimitsDxe/LimitsDxe.inf", "LimitsDxe"),
+    ("GpiDxe/GpiDxe.inf", "GpiDxe"),
+    ("UCDxe/UCDxe.inf", "UCDxe"),
+    ("RNGDxe/RngDxe.inf", "RngDxe"),
+    ("RscDxe/RscDxe.inf", "RscDxe"),
+]
+
+INF_TEMPLATE = """[Defines]
+  INF_VERSION                    = 0x0001001B
+  BASE_NAME                      = {base}
+  FILE_GUID                      = {guid}
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = EfiEntry
+
+[Binaries.AARCH64]
+{binaries}
+[Depex]
+  TRUE
+"""
+
+
+def main() -> int:
+    # .../<mcOS>/workspace/uefi-uke/Platforms/Xiaomi/ukePkg/Tools/this
+    here = Path(__file__).resolve()
+    tree = here.parents[4]            # uefi-uke checkout
+    repo = here.parents[6] if len(here.parents) > 6 else tree  # mcOS checkout root
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--source",
+        type=Path,
+        default=repo / "work/analysis/ref/vendor-dxe",
+        help="extraction directory with <name>.efi/<name>.depex/manifest.json",
+    )
+    parser.add_argument(
+        "--dest",
+        type=Path,
+        default=tree / "Binaries/uke/QcomPkg/Drivers",
+    )
+    parser.add_argument("--check", action="store_true", help="verify only, write nothing")
+    args = parser.parse_args()
+
+    manifest = json.loads((args.source / "manifest.json").read_text())
+    by_name = {}
+    for entry in manifest:
+        # several FFS files can share a UI name; keep the largest PE32
+        if entry["name"]:
+            by_name.setdefault(entry["name"], []).append(entry)
+    for name in by_name:
+        by_name[name].sort(key=lambda e: e["bytes"], reverse=True)
+
+    missing = [stock for _, stock in MODULES if stock not in by_name]
+    if missing:
+        print(f"error: not in {args.source}: {', '.join(missing)}", file=sys.stderr)
+        return 1
+
+    written = skipped = 0
+    for rel, stock in MODULES:
+        entry = by_name[stock][0]
+        out_dir = args.dest / Path(rel).parent
+        base = Path(rel).stem
+        pe_src = args.source / entry["file"]
+        depex_src = args.source / entry["depex_file"] if entry.get("depex_file") else None
+
+        binaries = []
+        if depex_src:
+            binaries.append(f"  DXE_DEPEX|{base}.depex|*")
+        binaries.append(f"  PE32|{base}.efi|*")
+        inf = INF_TEMPLATE.format(
+            base=base, guid=entry["ffs_guid"].upper(), binaries="\n".join(binaries) + "\n"
+        )
+
+        if args.check:
+            ok = (out_dir / f"{base}.inf").exists() and (out_dir / f"{base}.efi").exists()
+            print(f"{'ok   ' if ok else 'MISS '} {rel}  <- {stock}")
+            skipped += 0 if ok else 1
+            continue
+
+        out_dir.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(pe_src, out_dir / f"{base}.efi")
+        if depex_src:
+            shutil.copyfile(depex_src, out_dir / f"{base}.depex")
+        elif (out_dir / f"{base}.depex").exists():
+            (out_dir / f"{base}.depex").unlink()
+        (out_dir / f"{base}.inf").write_text(inf)
+        written += 1
+        print(f"{rel:<44} {entry['bytes']:>7} B  {entry['ffs_guid']}  <- {stock}")
+
+    if args.check:
+        print(f"\n{len(MODULES) - skipped}/{len(MODULES)} present")
+        return 1 if skipped else 0
+    print(f"\n{written} modules -> {args.dest}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/Platforms/Xiaomi/ukePkg/uke.dec b/Platforms/Xiaomi/ukePkg/uke.dec
