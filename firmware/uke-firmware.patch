diff --git a/Platforms/Xiaomi/ukePkg/Drivers/UkeUsbLogDxe/UkeUsbLogDxe.c b/Platforms/Xiaomi/ukePkg/Drivers/UkeUsbLogDxe/UkeUsbLogDxe.c
