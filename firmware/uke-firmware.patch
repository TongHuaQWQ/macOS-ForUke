+## @file
+#  uke (Xiaomi Pad 7, SM7675) platform package.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+[Defines]
+  DEC_SPECIFICATION = 0x0001001B
+  PACKAGE_NAME      = ukePkg
+  PACKAGE_GUID      = 7E3A5B2C-4D6F-4A8B-9C1D-2E3F4A5B6C7F
+  PACKAGE_VERSION   = 0.1
+
+[Guids]
+  gUkePkgTokenSpaceGuid = { 0x7E3A5B2C, 0x4D6F, 0x4A8B, { 0x9C, 0x1D, 0x2E, 0x3F, 0x4A, 0x5B, 0x6C, 0x70 } }
+
+[PcdsFixedAtBuild]
+  ## Seconds the USB mass-storage window stays open before ReadyToBoot continues.
+  #  0 disables the USB part of the log channel (diagnostics still run).
+  gUkePkgTokenSpaceGuid.PcdUkeUsbLogHoldSeconds|0|UINT32|0x00000001
+  ## The /chosen/pram window XNU keeps its embedded panic log in
+  #  (board.toml [payload.adt] panic_region). UkeUsbLogDxe copies whatever the
+  #  previous boot left there into the log disk, so the kernel log reaches the
+  #  host without any kernel-side storage driver.
+  gUkePkgTokenSpaceGuid.PcdUkePramBase|0|UINT64|0x00000002
+  gUkePkgTokenSpaceGuid.PcdUkePramSize|0|UINT64|0x00000003
diff --git a/Platforms/Xiaomi/ukePkg/uke.dsc b/Platforms/Xiaomi/ukePkg/uke.dsc
