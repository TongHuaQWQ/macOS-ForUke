index 00000000..b6d31913
--- /dev/null
+++ b/Platforms/Xiaomi/ukePkg/Drivers/UkeUsbLogDxe/UkeUsbLogDxe.c
@@ -0,0 +1,720 @@
+/** @file
+  uke USB log channel.
+
+  The tablet has no accessible UART and no USB host driver, so until now the only
+  way to read a boot log was a photograph of the panel.  The stock firmware does
+  ship a USB *device* stack (Dwc3 function controller + UsbConfig + UsbMsd), and
+  UsbMsdDxe hands any EFI_BLOCK_IO_PROTOCOL to the host as a mass storage LUN.
+  This driver uses it twice over:
+
+    * it publishes a small writable RAM block device ("UKE-LOG") whose contents
+      are this driver's own log text, and
+    * it offers the UFS LUNs the vendor UFSDxe brought up.
+
+  Both are assigned to USB MSD LUNs and started a configurable number of seconds
+  before ReadyToBoot, so the host sees them as plain disks: a `dd` of the UKE-LOG
+  disk returns the text log, no photograph involved.
+
+  The window is armed by PcdUkeUsbLogHoldSeconds; 0 skips the USB part (the
+  diagnostics are still logged).  Volume-up ends the window early, matching the
+  vendor MassStorage application.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+
+#include <Guid/EventGroup.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/PcdLib.h>
+#include <Library/DxeServicesTableLib.h>
+#include <Library/PrintLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiDriverEntryPoint.h>
+#include <Library/UefiLib.h>
+#include <Library/DevicePathLib.h>
+#include <Protocol/BlockIo.h>
+#include <Protocol/DevicePath.h>
+#include <Protocol/SimpleTextIn.h>
+
+//
+// The QcomPkg USB headers cannot be included here: EFIUsbfnIo.h pulls in
+// Protocol/EFIUsbEx.h, which redefines the MdePkg USB descriptors.  The two
+// pieces this driver needs are small, so they are declared locally from
+// QcomPkg.dec / Protocol/EFIUsbMsd.h instead.
+//
+typedef struct _UKE_USB_MSD_PROTOCOL UKE_USB_MSD_PROTOCOL;
+
+typedef
+EFI_STATUS
+(EFIAPI *UKE_MSD_ASSIGN_BLK_IO) (
+  IN UKE_USB_MSD_PROTOCOL  *This,
+  IN EFI_BLOCK_IO_PROTOCOL *BlkIo,
+  IN UINT32                 Lun
+  );
+
+typedef
+EFI_STATUS
+(EFIAPI *UKE_MSD_QUERY_MAX_LUN) (
+  IN  UKE_USB_MSD_PROTOCOL *This,
+  OUT UINT8                *Count
+  );
+
+typedef
+EFI_STATUS
+(EFIAPI *UKE_MSD_SIMPLE) (
+  IN UKE_USB_MSD_PROTOCOL *This
+  );
+
+//
+// Layout and order from QcomPkg/Include/Protocol/EFIUsbMsd.h.
+//
+struct _UKE_USB_MSD_PROTOCOL {
+  UINT32                  Revision;
+  UKE_MSD_ASSIGN_BLK_IO   AssignBlkIoHandle;
+  UKE_MSD_QUERY_MAX_LUN   QueryMaxLun;
+  UKE_MSD_SIMPLE          EventHandler;
+  UKE_MSD_SIMPLE          StartDevice;
+  UKE_MSD_SIMPLE          StopDevice;
+  VOID                    *GetDeviceSpeed;
+  VOID                    *UnmountHandle;
+  VOID                    *MountHandle;
+  VOID                    *FindPartitions;
+};
+
+STATIC EFI_GUID  mUsbMsdProtocolGuid = {
+  0xC8591FAF, 0xDBCC, 0x479E, { 0x9E, 0xF2, 0xFD, 0x08, 0x5B, 0xC3, 0x7B, 0xC7 }
+};
+
+STATIC EFI_GUID  mUsbfnIoProtocolGuid = {
+  0x32D2963A, 0xFE5D, 0x4F30, { 0xB6, 0x33, 0x6E, 0x5D, 0xC5, 0x58, 0x03, 0xCC }
+};
+
+#define UKE_LOG_BLOCK_SIZE  EFI_PAGE_SIZE
+#define UKE_LOG_BLOCKS      256 /* 1 MiB of text: UEFI phase + the previous boot */
+#define UKE_PRAM_TEXT_MAX   (192 * 1024) /* how much of the pram window we copy */
+#define UKE_PANEL_TAIL_LINES 34          /* lines of the previous log echoed to the panel */
+#define UKE_LOG_MAX_LUNS    8
+#define UKE_LOG_LINE_MAX    200
+
+//
+// UFS logical unit device paths, from QcomPkg.dec (gEfiUfsLUnGuid): the vendor
+// UFSDxe tags each LUN's device path with one of these.
+//
+STATIC EFI_GUID  mUfsLuGuid[UKE_LOG_MAX_LUNS] = {
+  { 0x860845C1, 0xBE09, 0x4355, { 0x8B, 0xC1, 0x30, 0xD6, 0x4F, 0xF8, 0xE6, 0x3A } },
+  { 0x8D90D477, 0x39A3, 0x4A38, { 0xAB, 0x9E, 0x58, 0x6F, 0xF6, 0x9E, 0xD0, 0x51 } },
+  { 0xEDF85868, 0x87EC, 0x4F77, { 0x9C, 0xDA, 0x5F, 0x10, 0xDF, 0x2F, 0xE6, 0x01 } },
+  { 0x1AE69024, 0x8AEB, 0x4DF8, { 0xBC, 0x98, 0x00, 0x32, 0xDB, 0xDF, 0x50, 0x24 } },
+  { 0xD33F1985, 0xF107, 0x4A85, { 0xBE, 0x38, 0x68, 0xDC, 0x7A, 0xD3, 0x2C, 0xEA } },
+  { 0x4BA1D05F, 0x088E, 0x483F, { 0xA9, 0x7E, 0xB1, 0x9B, 0x9C, 0xCF, 0x59, 0xB0 } },
+  { 0x4ACF98F6, 0x26FA, 0x44D2, { 0x81, 0x32, 0x28, 0x2F, 0x2D, 0x19, 0xA4, 0xC5 } },
+  { 0x8598155F, 0x34DE, 0x415C, { 0x8B, 0x55, 0x84, 0x3E, 0x33, 0x22, 0xD3, 0x6F } },
+};
+
+STATIC CONST CHAR8  *mUfsLuName[UKE_LOG_MAX_LUNS] = {
+  "UFS-LU0", "UFS-LU1", "UFS-LU2", "UFS-LU3",
+  "UFS-LU4", "UFS-LU5", "UFS-LU6", "UFS-LU7",
+};
+
+STATIC EFI_GUID  mUkeLogDiskGuid = {
+  0x75B0C3A1, 0x1D2E, 0x4C3B, { 0x9F, 0x6A, 0x11, 0x2C, 0x88, 0x40, 0x5E, 0xD7 }
+};
+
+#pragma pack(1)
+typedef struct {
+  VENDOR_DEVICE_PATH        Vendor;
+  EFI_DEVICE_PATH_PROTOCOL  End;
+} UKE_LOG_DEVICE_PATH;
+#pragma pack()
+
+STATIC UKE_LOG_DEVICE_PATH  mDevicePath;
+
+//
+// The media the host reads, so appending a line here is visible to the next host
+// read: the boot log is served live.
+//
+STATIC CHAR8                  mLog[UKE_LOG_BLOCKS * UKE_LOG_BLOCK_SIZE];
+STATIC UINTN                  mLogLen;
+STATIC EFI_BLOCK_IO_MEDIA     mLogMedia;
+STATIC EFI_BLOCK_IO_PROTOCOL  mLogBlockIo;
+
+/**
+  Bridge to Gunyah's virtual watchdog (the same calls UkeBootMemoryDxe makes, which are the
+  ones Android's gh_virt_wdt driver makes). The tablet resets about half a minute into a boot
+  nobody pets, and this driver holds the CPU for the mass-storage window, so it pets too.
+**/
+STATIC
+VOID
+UkeWatchdogPet (
+  OUT UINT64  *Status
+  )
+{
+  register UINT64 X0 __asm ("x0") = 0x86000007;
+  register UINT64 X1 __asm ("x1") = 0;
+  register UINT64 X2 __asm ("x2") = 0;
+  register UINT64 X3 __asm ("x3") = 0;
+  register UINT64 X4 __asm ("x4") = 0;
+  register UINT64 X5 __asm ("x5") = 0;
+  register UINT64 X6 __asm ("x6") = 0;
+  register UINT64 X7 __asm ("x7") = 0;
+
+  __asm__ volatile (
+    "smc #0"
+    : "+r" (X0), "+r" (X1)
+    : "r" (X2), "r" (X3), "r" (X4), "r" (X5), "r" (X6), "r" (X7)
+    : "memory"
+    );
+
+  if (Status != NULL) {
+    *Status = X0;
+  }
+}
+
+STATIC
+VOID
+Log (
+  IN CONST CHAR8  *Format,
+  ...
+  )
+{
+  VA_LIST  Args;
+  UINTN    Printed;
+
+  if (mLogLen + UKE_LOG_LINE_MAX + 2 > sizeof (mLog)) {
+    return;
+  }
+
+  VA_START (Args, Format);
+  Printed = AsciiVSPrint (&mLog[mLogLen], UKE_LOG_LINE_MAX, Format, Args);
+  VA_END (Args);
+
+  if ((Printed == 0) || (Printed >= UKE_LOG_LINE_MAX)) {
+    return;
+  }
+
+  mLog[mLogLen + Printed]     = '\n';
+  mLog[mLogLen + Printed + 1] = '\0';
+  AsciiPrint ("%a", &mLog[mLogLen]);
+  mLogLen += Printed + 1;
+
+  /* the buffer is NUL terminated after the newline, so this stays a C string */
+  mLog[mLogLen] = '\0';
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+LogDiskReset (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN BOOLEAN                 ExtendedVerification
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+LogDiskRead (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN UINT32                  MediaId,
+  IN EFI_LBA                 Lba,
+  IN UINTN                   BufferSize,
+  OUT VOID                  *Buffer
+  )
+{
+  if ((BufferSize % UKE_LOG_BLOCK_SIZE) != 0) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  if ((Lba > mLogMedia.LastBlock) ||
+      ((BufferSize / UKE_LOG_BLOCK_SIZE) > mLogMedia.LastBlock + 1 - Lba))
+  {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  CopyMem (Buffer, &mLog[Lba * UKE_LOG_BLOCK_SIZE], BufferSize);
+  return EFI_SUCCESS;
+}
+
+/**
+  The host may write the log area; the UEFI side treats it as opaque scratch and
+  never reparses it.
+**/
+STATIC
+EFI_STATUS
+EFIAPI
+LogDiskWrite (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN UINT32                  MediaId,
+  IN EFI_LBA                 Lba,
+  IN UINTN                   BufferSize,
+  IN VOID                   *Buffer
+  )
+{
+  if ((BufferSize % UKE_LOG_BLOCK_SIZE) != 0) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  if ((Lba > mLogMedia.LastBlock) ||
+      ((BufferSize / UKE_LOG_BLOCK_SIZE) > mLogMedia.LastBlock + 1 - Lba))
+  {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  CopyMem (&mLog[Lba * UKE_LOG_BLOCK_SIZE], Buffer, BufferSize);
+  mLogLen = 0;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+LogDiskFlush (
+  IN EFI_BLOCK_IO_PROTOCOL  *This
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+InstallLogDisk (
+  VOID
+  )
+{
+  EFI_HANDLE  Handle;
+
+  mLogMedia.MediaId          = 1;
+  mLogMedia.RemovableMedia   = FALSE;
+  mLogMedia.MediaPresent     = TRUE;
+  mLogMedia.LogicalPartition = FALSE;
+  mLogMedia.ReadOnly         = FALSE;
+  mLogMedia.WriteCaching     = FALSE;
+  mLogMedia.BlockSize        = UKE_LOG_BLOCK_SIZE;
+  mLogMedia.IoAlign          = 1;
+  mLogMedia.LastBlock        = UKE_LOG_BLOCKS - 1;
+
+  mLogBlockIo.Revision    = EFI_BLOCK_IO_PROTOCOL_REVISION;
+  mLogBlockIo.Media       = &mLogMedia;
+  mLogBlockIo.Reset       = LogDiskReset;
+  mLogBlockIo.ReadBlocks  = LogDiskRead;
+  mLogBlockIo.WriteBlocks = LogDiskWrite;
+  mLogBlockIo.FlushBlocks = LogDiskFlush;
+
+  mDevicePath.Vendor.Header.Type    = HARDWARE_DEVICE_PATH;
+  mDevicePath.Vendor.Header.SubType = HW_VENDOR_DP;
+  SetDevicePathNodeLength (&mDevicePath.Vendor, sizeof (VENDOR_DEVICE_PATH));
+  CopyMem (&mDevicePath.Vendor.Guid, &mUkeLogDiskGuid, sizeof (EFI_GUID));
+  mDevicePath.End.Type    = END_DEVICE_PATH_TYPE;
+  mDevicePath.End.SubType = END_ENTIRE_DEVICE_PATH_SUBTYPE;
+  SetDevicePathNodeLength (&mDevicePath.End, sizeof (EFI_DEVICE_PATH_PROTOCOL));
+
+  Handle = NULL;
+  return gBS->InstallMultipleProtocolInterfaces (
+                &Handle,
+                &gEfiDevicePathProtocolGuid,
+                &mDevicePath,
+                &gEfiBlockIoProtocolGuid,
+                &mLogBlockIo,
+                NULL
+                );
+}
+
+/**
+  Name a block device from the vendor GUID in its device path, so a photo of the
+  panel says which UFS LUN came up instead of "block device 3".
+**/
+STATIC
+CONST CHAR8 *
+BlockIoName (
+  IN EFI_HANDLE  Handle
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Path;
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+  UINTN                      Index;
+
+  if (EFI_ERROR (gBS->HandleProtocol (Handle, &gEfiDevicePathProtocolGuid, (VOID **)&Path))) {
+    return "block";
+  }
+
+  for (Node = Path; !IsDevicePathEnd (Node); Node = NextDevicePathNode (Node)) {
+    if ((DevicePathType (Node) == HARDWARE_DEVICE_PATH) && (DevicePathSubType (Node) == HW_VENDOR_DP)) {
+      VENDOR_DEVICE_PATH  *Vendor = (VENDOR_DEVICE_PATH *)Node;
+
+      if (CompareGuid (&Vendor->Guid, &mUkeLogDiskGuid)) {
+        return "UKE-LOG";
+      }
+
+      for (Index = 0; Index < UKE_LOG_MAX_LUNS; Index++) {
+        if (CompareGuid (&Vendor->Guid, &mUfsLuGuid[Index])) {
+          return mUfsLuName[Index];
+        }
+      }
+    }
+  }
+
+  return "block";
+}
+
+/**
+  Append bytes to the log media without mirroring them to the console: a pram
+  dump is far too long for the panel, but the host reads the whole disk.
+**/
+STATIC
+VOID
+LogAppendRaw (
+  IN CONST CHAR8  *Text,
+  IN UINTN         Length
+  )
+{
+  UINTN  Room;
+
+  if (Length == 0) {
+    return;
+  }
+
+  Room = sizeof (mLog) - mLogLen - 1;
+  if (Length > Room) {
+    Length = Room;
+  }
+
+  CopyMem (&mLog[mLogLen], Text, Length);
+  mLogLen += Length;
+  mLog[mLogLen] = '\0';
+}
+
+/**
+  Copy the previous boot's kernel log out of the pram window.
+
+  XNU keeps its embedded panic record (and, with the sheng log writer, a msgbuf
+  snapshot) in the reserved /chosen/pram region, which nothing rewrites across a
+  reset, so the next UEFI run can lift it into the log disk.  That is what makes
+  a kernel log readable over USB: the kernel needs no storage driver for it.
+
+  Only printable runs are kept (joined by newlines); the region is otherwise raw
+  DRAM, and when DRAM did not survive the reset the summary line says so.
+**/
+STATIC
+VOID
+DumpPreviousBootLog (
+  VOID
+  )
+{
+  EFI_STATUS                  Status;
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR  Descriptor;
+  UINT64                      Base;
+  UINT64                      Size;
+  CONST UINT8                *Pram;
+  UINTN                       Index;
+  UINTN                       RunStart;
+  UINTN                       Printable;
+  UINTN                       TextBytes;
+  CHAR8                       Sample[49];
+  UINTN                       PanelTail[UKE_PANEL_TAIL_LINES];
+  UINTN                       PanelTailAt;
+  UINTN                       PanelTailCount;
+
+  Base = PcdGet64 (PcdUkePramBase);
+  Size = PcdGet64 (PcdUkePramSize);
+  if ((Base == 0) || (Size < EFI_PAGE_SIZE)) {
+    Log ("pram: not configured");
+    return;
+  }
+
+  //
+  // Only touch the window when the DXE core knows it: an unmapped read here
+  // would fault before anything is served to the host.
+  //
+  Status = gDS->GetMemorySpaceDescriptor (Base, &Descriptor);
+  if (EFI_ERROR (Status)) {
+    Log ("pram: 0x%lx not described %r", Base, Status);
+    return;
+  }
+
+  Pram          = (CONST UINT8 *)(UINTN)Base;
+  Printable     = 0;
+  TextBytes     = 0;
+  RunStart      = 0;
+  PanelTailAt   = 0;
+  PanelTailCount = 0;
+  Sample[0]     = '\0';
+
+  Log ("--- pram 0x%lx (%u KiB) from the previous boot ---", Base, Size / 1024);
+
+  for (Index = 0; Index <= Size; Index++) {
+    BOOLEAN  Keep;
+
+    Keep = (Index < Size) &&
+           (((Pram[Index] >= 0x20) && (Pram[Index] < 0x7f)) ||
+            (Pram[Index] == '\t') || (Pram[Index] == '\r'));
+
+    if (Keep) {
+      if (Printable == 0) {
+        RunStart = Index;
+      }
+
+      Printable++;
+      continue;
+    }
+
+    //
+    // End of a run: keep it when it looks like text rather than a stray byte.
+    //
+    if (Printable >= 8) {
+      if ((Sample[0] == '\0') && (Printable >= 16)) {
+        UINTN  Copy = Printable;
+
+        if (Copy > sizeof (Sample) - 1) {
+          Copy = sizeof (Sample) - 1;
+        }
+
+        CopyMem (Sample, &Pram[RunStart], Copy);
+        Sample[Copy] = '\0';
+      }
+
+      if (TextBytes + Printable + 2 < UKE_PRAM_TEXT_MAX) {
+        PanelTail[PanelTailAt] = mLogLen;
+        PanelTailAt = (PanelTailAt + 1) % UKE_PANEL_TAIL_LINES;
+        if (PanelTailCount < UKE_PANEL_TAIL_LINES) {
+          PanelTailCount++;
+        }
+
+        LogAppendRaw ((CONST CHAR8 *)&Pram[RunStart], Printable);
+        LogAppendRaw ("\n", 1);
+        TextBytes += Printable + 1;
+      }
+    }
+
+    Printable = 0;
+  }
+
+  Log ("--- pram end: %u KiB of text kept ---", TextBytes / 1024);
+  if (Sample[0] != '\0') {
+    Log ("pram first text: \"%a\"", Sample);
+  } else {
+    Log ("pram first text: <none: DRAM did not survive, or the kernel never wrote>");
+  }
+
+  //
+  // Fallback for a host that cannot reach the USB LUN: echo the newest lines onto the panel while the
+  // mass-storage window holds the screen still. About 34 lines fit in a photograph of this display, so
+  // even with no USB at all the tail of the previous boot's kernel log is readable.
+  //
+  if (PanelTailCount > 0) {
+    UINTN  Line;
+    UINTN  First;
+
+    AsciiPrint ("--- previous boot log, last %u lines ---\n", PanelTailCount);
+    First = (PanelTailAt + UKE_PANEL_TAIL_LINES - PanelTailCount) % UKE_PANEL_TAIL_LINES;
+    for (Line = 0; Line < PanelTailCount; Line++) {
+      AsciiPrint ("%a\n", &mLog[PanelTail[(First + Line) % UKE_PANEL_TAIL_LINES]]);
+    }
+  }
+}
+
+STATIC
+BOOLEAN
+VolumeUpPressed (
+  VOID
+  )
+{
+  EFI_INPUT_KEY  Key;
+
+  if ((gST->ConIn == NULL) || (gST->ConIn->ReadKeyStroke == NULL)) {
+    return FALSE;
+  }
+
+  while (!EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) {
+    if (Key.ScanCode == SCAN_UP) {
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+/**
+  ReadyToBoot: by now BDS has dispatched every driver it could (it walks the
+  remaining queue through gDS->Dispatch while connecting controllers), so this is
+  the first moment the USB MSD and the UFS LUNs are both present.
+**/
+STATIC
+VOID
+EFIAPI
+UkeUsbLogReadyToBoot (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS               Status;
+  UKE_USB_MSD_PROTOCOL     *Msd;
+  VOID                     *UsbFn;
+  EFI_HANDLE               *Handles;
+  UINTN                     HandleCount;
+  UINTN                     Index;
+  UINT8                     MaxLun;
+  UINT8                     Assigned;
+  UINT32                    HoldSeconds;
+  EFI_BLOCK_IO_PROTOCOL    *Candidates[UKE_LOG_MAX_LUNS];
+  UINTN                     CandidateCount;
+
+  Handles        = NULL;
+  HandleCount    = 0;
+  MaxLun         = 0;
+  Assigned       = 0;
+  CandidateCount = 0;
+  HoldSeconds    = PcdGet32 (PcdUkeUsbLogHoldSeconds);
+
+  Log ("UKE-LOG: ready-to-boot hold=%u", HoldSeconds);
+  DumpPreviousBootLog ();
+
+  Status = gBS->LocateProtocol (&mUsbMsdProtocolGuid, NULL, (VOID **)&Msd);
+  Log ("UKE-LOG: usb-msd %r", Status);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  Status = gBS->LocateProtocol (&mUsbfnIoProtocolGuid, NULL, (VOID **)&UsbFn);
+  Log ("UKE-LOG: usbfn-io %r", Status);
+
+  Status = Msd->QueryMaxLun (Msd, &MaxLun);
+  Log ("UKE-LOG: max-lun=%u %r", MaxLun, Status);
+  if (EFI_ERROR (Status) || (MaxLun == 0)) {
+    return;
+  }
+
+  //
+  // The RAM log disk always goes first so it is LUN 0 on the host.
+  //
+  Candidates[CandidateCount++] = &mLogBlockIo;
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiBlockIoProtocolGuid,
+                  NULL,
+                  &HandleCount,
+                  &Handles
+                  );
+  if (EFI_ERROR (Status)) {
+    Log ("UKE-LOG: no block io %r", Status);
+    return;
+  }
+
+  for (Index = 0; (Index < HandleCount) && (CandidateCount < UKE_LOG_MAX_LUNS); Index++) {
+    EFI_BLOCK_IO_PROTOCOL  *BlockIo;
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiBlockIoProtocolGuid, (VOID **)&BlockIo))) {
+      continue;
+    }
+
+    if ((BlockIo->Media == NULL) || !BlockIo->Media->MediaPresent || (BlockIo == &mLogBlockIo)) {
+      continue;
+    }
+
+    Log (
+         "UKE-LOG: blk %a %uMB w=%u",
+         BlockIoName (Handles[Index]),
+         (UINTN)((BlockIo->Media->LastBlock + 1) * BlockIo->Media->BlockSize / (1024 * 1024)),
+         (UINTN)(BlockIo->Media->ReadOnly ? 0 : 1)
+         );
+
+    Candidates[CandidateCount++] = BlockIo;
+  }
+
+  Log ("UKE-LOG: %u candidates of %u handles", CandidateCount, HandleCount);
+  gBS->FreePool (Handles);
+
+  for (Index = 0; (Index < CandidateCount) && (Assigned < MaxLun); Index++) {
+    Status = Msd->AssignBlkIoHandle (Msd, Candidates[Index], Assigned);
+    if (EFI_ERROR (Status)) {
+      Log ("UKE-LOG: assign lun%u %r", (UINTN)Assigned, Status);
+      continue;
+    }
+
+    Assigned++;
+  }
+
+  Log ("UKE-LOG: assigned %u luns", (UINTN)Assigned);
+  if (Assigned == 0) {
+    return;
+  }
+
+  Status = Msd->StartDevice (Msd);
+  Log ("UKE-LOG: start %r", Status);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  gBS->SetWatchdogTimer (0, 0, 0, NULL);
+  Log ("UKE-LOG: usb up, vol-up ends");
+
+  {
+    UINT64  WatchdogStatus;
+    UkeWatchdogPet (&WatchdogStatus);
+    Log ("UKE-LOG: gunyah pet %lx", WatchdogStatus);
+  }
+
+  while (HoldSeconds > 0) {
+    (VOID)Msd->EventHandler (Msd);
+    if (VolumeUpPressed ()) {
+      Log ("UKE-LOG: volume-up");
+      break;
+    }
+
+    UkeWatchdogPet (NULL);
+    gBS->Stall (20 * 1000);
+    if ((HoldSeconds % 5) == 0) {
+      Log ("UKE-LOG: t=%u", HoldSeconds);
+    }
+
+    HoldSeconds--;
+  }
+
+  Status = Msd->StopDevice (Msd);
+  Log ("UKE-LOG: stop %r, booting on", Status);
+}
+
+EFI_STATUS
+EFIAPI
+UkeUsbLogDxeEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+  EFI_EVENT   Event;
+
+  ZeroMem (mLog, sizeof (mLog));
+  mLogLen = 0;
+
+  //
+  // First line of the disk: if the firmware dies before ReadyToBoot this is the only
+  // evidence that this driver's entry point ran at all.
+  //
+  Log ("UKE-LOG: driver entry");
+
+  Status = InstallLogDisk ();
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "UKE-LOG: cannot publish the log disk: %r\n", Status));
+  }
+
+  Status = gBS->CreateEventEx (
+                  EVT_NOTIFY_SIGNAL,
+                  TPL_CALLBACK,
+                  UkeUsbLogReadyToBoot,
+                  NULL,
+                  &gEfiEventReadyToBootGuid,
+                  &Event
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "UKE-LOG: cannot arm ReadyToBoot: %r\n", Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
