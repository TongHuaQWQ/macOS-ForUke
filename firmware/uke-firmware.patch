index 00000000..a34baa08
--- /dev/null
+++ b/Platforms/Xiaomi/ukePkg/Drivers/UkeBootMemoryDxe/UkeBootMemoryDxe.c
@@ -0,0 +1,627 @@
+/** @file
+  Memory and RAM disk from the device tree the previous stage handed over.
+
+  The previous stage (a Linux-style boot loader) passes the physical address
+  of a flattened device tree in x0, which SEC keeps in a HOB. Its /memory
+  nodes list the real DRAM and its /reserved-memory nodes list what the
+  secure side owns. Without the vendor memory manager the firmware only knows
+  the few regions of its own memory map, so:
+
+  * DRAM that no firmware region claims and no reserved-memory node covers is
+    added to the GCD as system memory, up to a fixed amount;
+  * the initrd the loader placed in memory (/chosen linux,initrd-start/-end)
+    is published as a read-only block device, so a FAT image in the boot
+    image's ramdisk shows up as a normal volume.
+
+  Nothing here depends on a hardware address; every range comes from the DT.
+**/
+
+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/DxeServicesTableLib.h>
+#include <Library/FdtLib.h>
+#include <Library/HobLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <UkeMemStatus.h>
+#include <Protocol/BlockIo.h>
+#include <Protocol/DevicePath.h>
+
+#define MAX_RANGES        64
+#define MIN_PIECE_SIZE    SIZE_16MB
+#define ADD_LIMIT         SIZE_2GB     // DarwinBoot wants one contiguous 1 GiB window
+#define ADD_BELOW         SIZE_4GB     // stay inside what the MMU setup maps
+
+typedef struct {
+  UINT64  Base;
+  UINT64  End;       // exclusive
+} RANGE;
+
+STATIC UKE_MEM_STATUS  mMemStatus;
+
+STATIC
+UINT64
+ReadCells (
+  IN CONST VOID  *Data,
+  IN UINT32      Cells
+  )
+{
+  if (Cells == 2) {
+    return Fdt64ToCpu (ReadUnaligned64 (Data));
+  }
+
+  return Fdt32ToCpu (ReadUnaligned32 (Data));
+}
+
+STATIC
+UINT32
+GetCells (
+  IN CONST VOID  *Fdt,
+  IN INT32       Node,
+  IN CONST CHAR8 *Name,
+  IN UINT32      Default
+  )
+{
+  CONST VOID  *Prop;
+  INT32       Length;
+
+  Prop = FdtGetProp (Fdt, Node, Name, &Length);
+  if ((Prop == NULL) || (Length != sizeof (UINT32))) {
+    return Default;
+  }
+
+  return Fdt32ToCpu (ReadUnaligned32 (Prop));
+}
+
+STATIC
+UINTN
+CollectReg (
+  IN     CONST VOID  *Fdt,
+  IN     INT32       Node,
+  IN     UINT32      AddressCells,
+  IN     UINT32      SizeCells,
+  IN OUT RANGE       *Ranges,
+  IN     UINTN       Count
+  )
+{
+  CONST UINT8  *Reg;
+  INT32        Length;
+  UINT32       Entry;
+  INT32        Offset;
+  UINT64       Base;
+  UINT64       Size;
+
+  Reg = FdtGetProp (Fdt, Node, "reg", &Length);
+  if (Reg == NULL) {
+    return Count;
+  }
+
+  Entry = (AddressCells + SizeCells) * sizeof (UINT32);
+  for (Offset = 0; (Offset + (INT32)Entry <= Length) && (Count < MAX_RANGES); Offset += Entry) {
+    Base = ReadCells (Reg + Offset, AddressCells);
+    Size = ReadCells (Reg + Offset + AddressCells * sizeof (UINT32), SizeCells);
+    if ((Size != 0) && (Base + Size > Base)) {
+      Ranges[Count].Base = Base;
+      Ranges[Count].End  = Base + Size;
+      Count++;
+    }
+  }
+
+  return Count;
+}
+
+/**
+  Remove every part of Pieces[] that lies inside Cut.
+**/
+STATIC
+UINTN
+Subtract (
+  IN OUT RANGE  *Pieces,
+  IN     UINTN  Count,
+  IN     RANGE  Cut
+  )
+{
+  UINTN  Index;
+  UINTN  Result;
+  RANGE  Out[MAX_RANGES];
+
+  Result = 0;
+  for (Index = 0; Index < Count; Index++) {
+    if ((Cut.End <= Pieces[Index].Base) || (Cut.Base >= Pieces[Index].End)) {
+      if (Result < MAX_RANGES) {
+        Out[Result++] = Pieces[Index];
+      }
+
+      continue;
+    }
+
+    if ((Cut.Base > Pieces[Index].Base) && (Result < MAX_RANGES)) {
+      Out[Result].Base  = Pieces[Index].Base;
+      Out[Result].End   = Cut.Base;
+      Result++;
+    }
+
+    if ((Cut.End < Pieces[Index].End) && (Result < MAX_RANGES)) {
+      Out[Result].Base  = Cut.End;
+      Out[Result].End   = Pieces[Index].End;
+      Result++;
+    }
+  }
+
+  CopyMem (Pieces, Out, Result * sizeof (RANGE));
+  return Result;
+}
+
+STATIC
+VOID
+AddMemory (
+  IN CONST VOID  *Fdt
+  )
+{
+  EFI_STATUS                       Status;
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR  *Map;
+  UINTN                            MapCount;
+  INT32                            Root;
+  INT32                            Node;
+  INT32                            Reserved;
+  INT32                            Length;
+  CONST CHAR8                      *Type;
+  UINT32                           AddressCells;
+  UINT32                           SizeCells;
+  RANGE                            Banks[MAX_RANGES];
+  RANGE                            Holes[MAX_RANGES];
+  RANGE                            Pieces[MAX_RANGES];
+  UINTN                            BankCount;
+  UINTN                            HoleCount;
+  UINTN                            PieceCount;
+  UINTN                            ReservedCount;
+  RANGE                            ReservedRanges[MAX_RANGES];
+  UINTN                            Index;
+  UINTN                            Other;
+  UINT64                           Added;
+  UINT64                           Base;
+  UINT64                           End;
+
+  Root         = FdtPathOffset (Fdt, "/");
+  AddressCells = GetCells (Fdt, Root, "#address-cells", 2);
+  SizeCells    = GetCells (Fdt, Root, "#size-cells", 2);
+
+  BankCount = 0;
+  for (Node = FdtFirstSubnode (Fdt, Root); Node >= 0; Node = FdtNextSubnode (Fdt, Node)) {
+    Type = FdtGetProp (Fdt, Node, "device_type", &Length);
+    if ((Type != NULL) && (AsciiStrCmp (Type, "memory") == 0)) {
+      BankCount = CollectReg (Fdt, Node, AddressCells, SizeCells, Banks, BankCount);
+    }
+  }
+
+  ReservedCount = 0;
+  Reserved      = FdtPathOffset (Fdt, "/reserved-memory");
+  if (Reserved >= 0) {
+    UINT32  ResAddress = GetCells (Fdt, Reserved, "#address-cells", AddressCells);
+    UINT32  ResSize    = GetCells (Fdt, Reserved, "#size-cells", SizeCells);
+
+    for (Node = FdtFirstSubnode (Fdt, Reserved); Node >= 0; Node = FdtNextSubnode (Fdt, Node)) {
+      ReservedCount = CollectReg (Fdt, Node, ResAddress, ResSize, ReservedRanges, ReservedCount);
+    }
+  }
+
+  DEBUG ((DEBUG_ERROR, "UKEMEM: DT has %u memory ranges and %u reserved ranges\n", (UINT32)BankCount, (UINT32)ReservedCount));
+  for (Index = 0; Index < BankCount; Index++) {
+    DEBUG ((DEBUG_ERROR, "UKEMEM: DT memory %u: 0x%lx-0x%lx\n", (UINT32)Index, Banks[Index].Base, Banks[Index].End));
+  }
+  if (BankCount == 0) {
+    return;
+  }
+
+  Status = gDS->GetMemorySpaceMap (&MapCount, &Map);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  //
+  // MemoryMapLib declares the high banks statically from a 12 GB unit's DT (one 9 GiB run up to 0xB00000000).
+  // On a unit whose live DT has less DRAM there, or reserves part of it, those pages fault when touched (a
+  // DarwinBoot file read at 0xAFD229000 took a synchronous external abort). Fence every free page of that
+  // static system memory that the live DT does not describe as usable DRAM, so nothing allocates from it.
+  //
+  for (Other = 0; Other < MapCount; Other++) {
+    if ((Map[Other].GcdMemoryType != EfiGcdMemoryTypeSystemMemory) || (Map[Other].BaseAddress < SIZE_4GB)) {
+      continue;
+    }
+
+    Pieces[0].Base = Map[Other].BaseAddress;
+    Pieces[0].End  = Map[Other].BaseAddress + Map[Other].Length;
+    PieceCount     = 1;
+    for (Index = 0; Index < BankCount; Index++) {
+      PieceCount = Subtract (Pieces, PieceCount, Banks[Index]);
+    }
+
+    for (Index = 0; Index < ReservedCount; Index++) {
+      if (ReservedRanges[Index].End > Map[Other].BaseAddress) {
+        RANGE  Cut[MAX_RANGES];
+        UINTN  CutCount;
+
+        Cut[0]   = ReservedRanges[Index];
+        CutCount = 1;
+        CutCount = Subtract (Cut, CutCount, (RANGE){ 0, Map[Other].BaseAddress });
+        CutCount = Subtract (Cut, CutCount, (RANGE){ Map[Other].BaseAddress + Map[Other].Length, MAX_UINT64 });
+        if ((CutCount == 1) && (PieceCount < MAX_RANGES)) {
+          Pieces[PieceCount++] = Cut[0];
+        }
+      }
+    }
+
+    for (Index = 0; Index < PieceCount; Index++) {
+      UINT64  Chunk = Pieces[Index].Base & ~((UINT64)EFI_PAGE_SIZE - 1);
+      UINT64  Fenced = 0;
+
+      // Whole 2 MiB chunks where they are free, page by page only where something already holds part of one.
+      while (Chunk < Pieces[Index].End) {
+        UINT64                ChunkEnd = MIN (ALIGN_VALUE (Chunk + 1, SIZE_2MB), Pieces[Index].End);
+        EFI_PHYSICAL_ADDRESS  Address  = Chunk;
+        UINT64                Page;
+
+        if (!EFI_ERROR (gBS->AllocatePages (AllocateAddress, EfiReservedMemoryType,
+                                            EFI_SIZE_TO_PAGES (ChunkEnd - Chunk), &Address))) {
+          Fenced += ChunkEnd - Chunk;
+        } else {
+          for (Page = Chunk; Page < ChunkEnd; Page += EFI_PAGE_SIZE) {
+            Address = Page;
+            if (!EFI_ERROR (gBS->AllocatePages (AllocateAddress, EfiReservedMemoryType, 1, &Address))) {
+              Fenced += EFI_PAGE_SIZE;
+            }
+          }
+        }
+
+        Chunk = ChunkEnd;
+      }
+
+      DEBUG ((DEBUG_ERROR, "UKEMEM: fenced 0x%lx bytes of 0x%lx-0x%lx (not usable DRAM in the live DT)\n",
+              Fenced, Pieces[Index].Base, Pieces[Index].End));
+    }
+  }
+
+  //
+  // Holes: DRAM the GCD does not know yet.
+  //
+  HoleCount = 0;
+  for (Index = 0; Index < BankCount; Index++) {
+    for (Other = 0; Other < MapCount; Other++) {
+      if (Map[Other].GcdMemoryType != EfiGcdMemoryTypeNonExistent) {
+        continue;
+      }
+
+      Base = MAX (Banks[Index].Base, Map[Other].BaseAddress);
+      End  = MIN (Banks[Index].End, Map[Other].BaseAddress + Map[Other].Length);
+      if ((Base < End) && (HoleCount < MAX_RANGES)) {
+        Holes[HoleCount].Base = Base;
+        Holes[HoleCount].End  = End;
+        HoleCount++;
+      }
+    }
+  }
+
+  FreePool (Map);
+
+  //
+  // Minus everything the DT reserves; what is left is added right away.
+  //
+  Added = 0;
+  for (Index = 0; (Index < HoleCount) && (Added < ADD_LIMIT); Index++) {
+    Pieces[0]  = Holes[Index];
+    PieceCount = 1;
+    for (Other = 0; Other < ReservedCount; Other++) {
+      PieceCount = Subtract (Pieces, PieceCount, ReservedRanges[Other]);
+    }
+
+    for (Other = 0; (Other < PieceCount) && (Added < ADD_LIMIT); Other++) {
+      Base = ALIGN_VALUE (Pieces[Other].Base, SIZE_2MB);
+      End  = Pieces[Other].End & ~((UINT64)SIZE_2MB - 1);
+      if ((End <= Base) || (End - Base < MIN_PIECE_SIZE) || (End > ADD_BELOW)) {
+        continue;
+      }
+
+      End = MIN (End, Base + (ADD_LIMIT - Added));
+
+      //
+      // Add and map before anything can allocate from it.
+      //
+      Status = gDS->AddMemorySpace (
+                      EfiGcdMemoryTypeSystemMemory,
+                      Base,
+                      End - Base,
+                      EFI_MEMORY_UC | EFI_MEMORY_WC | EFI_MEMORY_WT | EFI_MEMORY_WB
+                      );
+      if (!EFI_ERROR (Status)) {
+        Status = gDS->SetMemorySpaceAttributes (Base, End - Base, EFI_MEMORY_WB);
+        if (EFI_ERROR (Status)) {
+          gDS->RemoveMemorySpace (Base, End - Base);
+        } else {
+          Added += End - Base;
+        }
+      }
+
+      DEBUG ((DEBUG_ERROR, "UKEMEM: system memory 0x%lx-0x%lx %r\n", Base, End - 1, Status));
+    }
+  }
+
+  DEBUG ((DEBUG_ERROR, "UKEMEM: added 0x%lx bytes of system memory\n", Added));
+}
+
+#define RAM_BLOCK_SIZE  512
+
+#pragma pack(1)
+typedef struct {
+  VENDOR_DEVICE_PATH          Vendor;
+  EFI_DEVICE_PATH_PROTOCOL    End;
+} RAM_BLOCK_DEVICE_PATH;
+#pragma pack()
+
+STATIC RAM_BLOCK_DEVICE_PATH  mDevicePath = {
+  {
+    { HARDWARE_DEVICE_PATH, HW_VENDOR_DP, { (UINT8)sizeof (VENDOR_DEVICE_PATH), (UINT8)(sizeof (VENDOR_DEVICE_PATH) >> 8) } },
+    { 0xA9C6827C, 0x1BD8, 0x410C, { 0x88, 0x5A, 0xC4, 0x65, 0x00, 0xF7, 0xD8, 0x36 } }
+  },
+  { END_DEVICE_PATH_TYPE, END_ENTIRE_DEVICE_PATH_SUBTYPE, { sizeof (EFI_DEVICE_PATH_PROTOCOL), 0 } }
+};
+
+STATIC UINT8                    *mRamBase;
+STATIC EFI_BLOCK_IO_MEDIA       mMedia;
+
+STATIC
+EFI_STATUS
+EFIAPI
+RamBlockReset (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN BOOLEAN                ExtendedVerification
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+RamBlockRead (
+  IN  EFI_BLOCK_IO_PROTOCOL  *This,
+  IN  UINT32                 MediaId,
+  IN  EFI_LBA                Lba,
+  IN  UINTN                  BufferSize,
+  OUT VOID                   *Buffer
+  )
+{
+  if (Buffer == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (MediaId != mMedia.MediaId) {
+    return EFI_MEDIA_CHANGED;
+  }
+
+  if ((BufferSize % RAM_BLOCK_SIZE) != 0) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  if ((Lba > mMedia.LastBlock) || ((BufferSize / RAM_BLOCK_SIZE) > (mMedia.LastBlock + 1 - Lba))) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  CopyMem (Buffer, mRamBase + Lba * RAM_BLOCK_SIZE, BufferSize);
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+RamBlockWrite (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN UINT32                 MediaId,
+  IN EFI_LBA                Lba,
+  IN UINTN                  BufferSize,
+  IN VOID                   *Buffer
+  )
+{
+  return EFI_WRITE_PROTECTED;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+RamBlockFlush (
+  IN EFI_BLOCK_IO_PROTOCOL  *This
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_BLOCK_IO_PROTOCOL  mBlockIo = {
+  EFI_BLOCK_IO_PROTOCOL_REVISION,
+  &mMedia,
+  RamBlockReset,
+  RamBlockRead,
+  RamBlockWrite,
+  RamBlockFlush
+};
+
+STATIC
+VOID
+PublishInitrd (
+  IN CONST VOID  *Fdt
+  )
+{
+  EFI_STATUS  Status;
+  INT32       Chosen;
+  CONST VOID  *StartProp;
+  CONST VOID  *EndProp;
+  INT32       StartLength;
+  INT32       EndLength;
+  UINT64      Start;
+  UINT64      End;
+  EFI_HANDLE  Handle;
+
+  Chosen = FdtPathOffset (Fdt, "/chosen");
+  if (Chosen < 0) {
+    DEBUG ((DEBUG_ERROR, "UKEMEM: no /chosen\n"));
+    return;
+  }
+
+  StartProp = FdtGetProp (Fdt, Chosen, "linux,initrd-start", &StartLength);
+  EndProp   = FdtGetProp (Fdt, Chosen, "linux,initrd-end", &EndLength);
+  if ((StartProp == NULL) || (EndProp == NULL) ||
+      ((StartLength != 4) && (StartLength != 8)) || ((EndLength != 4) && (EndLength != 8)))
+  {
+    DEBUG ((DEBUG_ERROR, "UKEMEM: no initrd in /chosen\n"));
+    return;
+  }
+
+  Start = ReadCells (StartProp, StartLength / 4);
+  End   = ReadCells (EndProp, EndLength / 4);
+  mMemStatus.InitrdStart = Start;
+  mMemStatus.InitrdEnd   = End;
+  if (End <= Start) {
+    DEBUG ((DEBUG_ERROR, "UKEMEM: initrd 0x%lx-0x%lx is empty\n", Start, End));
+    return;
+  }
+
+  //
+  // The loader's initrd range can include a DTB or bootconfig after the FAT
+  // image, so its end is not necessarily sector aligned. The FAT BPB knows
+  // the real volume size: drop the partial tail sector instead of refusing
+  // to publish the volume.
+  //
+  if (((End - Start) % RAM_BLOCK_SIZE) != 0) {
+    End &= ~((UINT64)RAM_BLOCK_SIZE - 1);
+    DEBUG ((DEBUG_ERROR, "UKEMEM: initrd end rounded to 0x%lx\n", End));
+    if (End <= Start) {
+      return;
+    }
+  }
+
+  //
+  // Add and map the initrd before any file system driver reads it; it can
+  // sit outside the DT /memory ranges.
+  //
+  Status = gDS->AddMemorySpace (
+                  EfiGcdMemoryTypeSystemMemory,
+                  Start,
+                  End - Start,
+                  EFI_MEMORY_UC | EFI_MEMORY_WC | EFI_MEMORY_WT | EFI_MEMORY_WB
+                  );
+  if (!EFI_ERROR (Status)) {
+    Status = gDS->SetMemorySpaceAttributes (Start, End - Start, EFI_MEMORY_WB);
+    if (EFI_ERROR (Status)) {
+      gDS->RemoveMemorySpace (Start, End - Start);
+    }
+  }
+
+  DEBUG ((DEBUG_ERROR, "UKEMEM: initrd memory 0x%lx-0x%lx %r\n", Start, End - 1, Status));
+
+  mRamBase                = (UINT8 *)(UINTN)Start;
+  mMedia.MediaId          = 1;
+  mMedia.RemovableMedia   = FALSE;
+  mMedia.MediaPresent     = TRUE;
+  mMedia.LogicalPartition = FALSE;
+  mMedia.ReadOnly         = TRUE;
+  mMedia.WriteCaching     = FALSE;
+  mMedia.BlockSize        = RAM_BLOCK_SIZE;
+  mMedia.IoAlign          = 1;
+  mMedia.LastBlock        = (End - Start) / RAM_BLOCK_SIZE - 1;
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEfiDevicePathProtocolGuid,
+                  &mDevicePath,
+                  &gEfiBlockIoProtocolGuid,
+                  &mBlockIo,
+                  NULL
+                  );
+  mMemStatus.InitrdPublished = EFI_ERROR (Status) ? 0 : 1;
+  DEBUG ((DEBUG_ERROR, "UKEMEM: initrd block device 0x%lx size 0x%lx %r\n", Start, End - Start, Status));
+}
+
+//
+// The device runs under Gunyah and the hypervisor arms a virtual watchdog.
+// Android's gh_virt_wdt driver disables it during probe and pets it while
+// /dev/watchdog is open; XNU has no such driver, so the tablet resets about
+// half a minute into the boot.  These are the same SMC calls the driver makes.
+//
+STATIC
+VOID
+UkeScmCall (
+  IN  UINT64  A0,
+  IN  UINT64  A1,
+  IN  UINT64  A2,
+  OUT UINT64  *R0,
+  OUT UINT64  *R1
+  )
+{
+  register UINT64 X0 __asm ("x0") = A0;
+  register UINT64 X1 __asm ("x1") = A1;
+  register UINT64 X2 __asm ("x2") = A2;
+  register UINT64 X3 __asm ("x3") = 0;
+  register UINT64 X4 __asm ("x4") = 0;
+  register UINT64 X5 __asm ("x5") = 0;
+  register UINT64 X6 __asm ("x6") = 0;
+  register UINT64 X7 __asm ("x7") = 0;
+
+  __asm__ volatile (
+    "smc #0"
+    : "+r" (X0), "+r" (X1)
+    : "r" (X2), "r" (X3), "r" (X4), "r" (X5), "r" (X6), "r" (X7)
+    : "memory"
+    );
+
+  *R0 = X0;
+  *R1 = X1;
+}
+
+EFI_STATUS
+EFIAPI
+UkeBootMemoryDxeEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_HOB_GUID_TYPE  *Hob;
+  UINT64             Dtb;
+  UINT64             Scm0;
+  UINT64             Scm1;
+  EFI_STATUS         Status;
+
+  UkeScmCall (0x86000008, 0xffff, 30000, &Scm0, &Scm1);
+  DEBUG ((DEBUG_ERROR, "UKEMEM: gunyah wdt time    0x%lx/0x%lx\n", Scm0, Scm1));
+  UkeScmCall (0x86000005, 2, 0, &Scm0, &Scm1);
+  DEBUG ((DEBUG_ERROR, "UKEMEM: gunyah wdt disable 0x%lx/0x%lx\n", Scm0, Scm1));
+  UkeScmCall (0x86000007, 0, 0, &Scm0, &Scm1);
+  DEBUG ((DEBUG_ERROR, "UKEMEM: gunyah wdt pet     0x%lx/0x%lx\n", Scm0, Scm1));
+
+  ZeroMem (&mMemStatus, sizeof (mMemStatus));
+  mMemStatus.Magic   = UKE_MEM_STATUS_MAGIC;
+  mMemStatus.Version = UKE_MEM_STATUS_VERSION;
+  Status             = gBS->InstallConfigurationTable (&gUkeMemStatusGuid, &mMemStatus);
+  DEBUG ((DEBUG_ERROR, "UKEMEM: status table %r\n", Status));
+
+  Hob = GetFirstGuidHob (&gSiliciumEntryArgHobGuid);
+  if (Hob == NULL) {
+    DEBUG ((DEBUG_ERROR, "UKEMEM: no entry argument HOB\n"));
+    return EFI_SUCCESS;
+  }
+
+  Dtb = *(UINT64 *)GET_GUID_HOB_DATA (Hob);
+  if ((Dtb == 0) || ((Dtb & 3) != 0) || (FdtCheckHeader ((VOID *)(UINTN)Dtb) != 0)) {
+    DEBUG ((DEBUG_ERROR, "UKEMEM: x0 0x%lx is not a device tree\n", Dtb));
+    return EFI_SUCCESS;
+  }
+
+  mMemStatus.DtbSource = UKE_MEM_DTB_HOB;
+  mMemStatus.Dtb       = Dtb;
+  mMemStatus.DtbSize   = (UINT32)FdtTotalSize ((VOID *)(UINTN)Dtb);
+  DEBUG ((DEBUG_ERROR, "UKEMEM: device tree at 0x%lx, %u bytes, source %u\n", Dtb, (UINT32)mMemStatus.DtbSize, mMemStatus.DtbSource));
+
+  AddMemory ((VOID *)(UINTN)Dtb);
+  PublishInitrd ((VOID *)(UINTN)Dtb);
+  return EFI_SUCCESS;
+}
