diff --git a/Resources/MuPatches/Gic-Spurious.patch b/Resources/MuPatches/Gic-Spurious.patch
new file mode 100644
index 00000000..0a574d38
--- /dev/null
+++ b/Resources/MuPatches/Gic-Spurious.patch
@@ -0,0 +1,25 @@
+diff --git a/ArmPkg/Drivers/ArmGicDxe/GicV3/ArmGicV3Dxe.c b/ArmPkg/Drivers/ArmGicDxe/GicV3/ArmGicV3Dxe.c
+index 5fd28e3..9fc5942 100644
+--- a/ArmPkg/Drivers/ArmGicDxe/GicV3/ArmGicV3Dxe.c
++++ b/ArmPkg/Drivers/ArmGicDxe/GicV3/ArmGicV3Dxe.c
+@@ -504,8 +504,20 @@ GicV3IrqInterruptHandler (
+     // Call the registered interrupt handler.
+     (*InterruptHandlerPtr)(GicInterrupt, SystemContext);
+   } else {
++    BOOLEAN  Enabled;
++
+     DEBUG ((DEBUG_ERROR, "Spurious GIC interrupt: 0x%x\n", (UINT32)GicInterrupt));
++
++    // A level interrupt without a handler fires again as soon as it is
++    // acknowledged and would starve the CPU. Mask it, like an unhandled IRQ
++    // in other kernels; registering a handler enables the source again.
++    GicV3DisableInterruptSource (&gHardwareInterruptV3Protocol, GicInterrupt);
+     GicV3EndOfInterrupt (&gHardwareInterruptV3Protocol, GicInterrupt);
++
++    Enabled = FALSE;
++    if (!EFI_ERROR (GicV3GetInterruptSourceState (&gHardwareInterruptV3Protocol, GicInterrupt, &Enabled)) && Enabled) {
++      DEBUG ((DEBUG_ERROR, "GIC interrupt 0x%x cannot be masked\n", (UINT32)GicInterrupt));
++    }
+   }
+ }
+ 
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa3..0b3073c3 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,17 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // The previous stage may enter with SPSel=0. Exceptions are then taken on
+  // the stale SP_EL1 instead of the stack set up below, so select SP_ELx
+  // first; the stack pointer written in MainEntryPoint is then SP_EL1.
+  msr   SPSel, #1
+  isb
+
+  // Keep x0 for the platform. It is the address of the DT a Linux-style boot
+  // loader hands over. The slot is in this section, which is in RAM here.
+  adr   x1, ASM_PFX (gSecEntryArg0)
+  str   x0, [x1]
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -61,3 +72,9 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  // First argument of the previous stage, written once at entry
+  .align 3
+  .global ASM_PFX (gSecEntryArg0)
+ASM_PFX (gSecEntryArg0):
+  .quad 0
