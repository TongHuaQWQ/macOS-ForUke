diff --git a/Platforms/Xiaomi/ukePkg/Include/RAW.inc b/Platforms/Xiaomi/ukePkg/Include/RAW.inc
new file mode 100644
index 00000000..2df50126
--- /dev/null
+++ b/Platforms/Xiaomi/ukePkg/Include/RAW.inc
@@ -0,0 +1,28 @@
+// Board raw files must come from uke firmware, not QRD8550.
+  FILE FREEFORM = A1E235DE-E825-4591-9623-C43175811826 {
+    SECTION UI = "SecParti.cfg"
+    SECTION RAW = Binaries/uke/RawFiles/SecParti.cfg
+  }
+
+!if $(USE_CUSTOM_DISPLAY_DRIVER) == 1
+  # The panel of this board is O82 "42 02 0b", a dual-DSI video-mode panel at 3200x2136 -- not N81A,
+  # and not 3048x2032. Three independent sources agree:
+  #   - the bootloader says so itself: "DSIPanelReadWpCoordinate: panel = O82_42_02_0b_dualdsi_dsc_vid"
+  #     and "GetAdjustLogoIndexpDisplayInfo->uDisplayWidth 3200: 2136"
+  #     (work/analysis/hw-dig/.raw/logfs/UEFILOG3.ascii.txt:400, :388);
+  #   - the stock firmware volume carries the XML twice, under the two GUIDs below, and carries no
+  #     "N81A" file and no 15A84758 GUID at all (work/analysis/hw-dig/.raw/stock-fv-B.fv: O82 XML at
+  #     0x2ed2ef under 43013DAA… and at 0x2ee7e7 under 95EB4C18…, both 0x14f5 bytes);
+  #   - the XML's own header: "O81 O82 42 02 0b Dual DSI DPHY Vid Mode LCD Panel (3200x2136 24bpp)".
+  # The previous content named Panel_N81A_36_02_0a_*.xml, a file that exists in no stock volume, and
+  # labelled 43013DAA as N81A when in the stock FV it holds the 42_02_0b panel. Both GUIDs are kept
+  # because the stock image ships the same XML under each of them.
+  FILE FREEFORM = 43013DAA-0CE4-4D82-99EE-17F772A38401 {
+    SECTION UI = "Panel_O81_42_02_0b_dualdsi_dsc_vid.xml"
+    SECTION RAW = Binaries/uke/RawFiles/Panel_O82_42_02_0b_dualdsi_dsc_vid.xml
+  }
+  FILE FREEFORM = 95EB4C18-E518-4068-BE0D-CB33119ADBB7 {
+    SECTION UI = "Panel_O82_42_02_0b_dualdsi_dsc_vid.xml"
+    SECTION RAW = Binaries/uke/RawFiles/Panel_O82_42_02_0b_dualdsi_dsc_vid.xml
+  }
+!endif
