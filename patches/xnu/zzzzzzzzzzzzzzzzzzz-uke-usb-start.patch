--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1110,6 +1110,32 @@
 
+/*
+ * uke-usb-start: the board entry of the official USB route (drivers/QcomDwc3, package/UsbProbe.cpp).
+ *
+ * Called from bsd_autoconf() and not, as the driver guide's reference board does, from
+ * native_legacy_display_late_probe(): that caller is compiled only with XNU_NATIVE_LEGACY_DISPLAY, which
+ * this board's configuration leaves off, so b251-usbdwc3 shipped with libQcomDwc3.a force-loaded and
+ * unreachable -- the built kernel carried _uke_usb_probe and no _native_legacy_display_late_probe at all.
+ * bsd_autoconf() is also where the qcom-usb-debug worker starts, and for the reason that decides this
+ * placement: this kernel has never returned from IOKitBSDInit(), so a board service called after it would
+ * never run.
+ *
+ * The weak definition is the "stub archive supplies a weak no-op" pattern this board already uses for
+ * sheng_gpu_power_probe (package/LegacyDisplayProbe.cpp), placed in the kernel instead of an archive
+ * because it has to hold for *every* configuration: the bootstrap configuration links without any
+ * archives, and an unresolved pac-signed import is a hard link failure there (the error
+ * zzzzzzzzzzzzzzzzz-uke-bsd-init-hook.patch records). Where build/qcom-dwc3/libQcomDwc3.a is linked its
+ * strong definition wins and this stub is never entered; a configuration without it still links, and says
+ * so if it ever runs.
+ */
+__attribute__((weak)) void
+uke_usb_probe(void)
+{
+	kprintf("UKE usb: no driver archive in this kernel (weak stub)\n");
+}
+
 kern_return_t
 bsd_autoconf(void)
 {
+	uke_usb_probe();
 	kprintf("bsd_autoconf: calling kminit\n");
 	kminit();
