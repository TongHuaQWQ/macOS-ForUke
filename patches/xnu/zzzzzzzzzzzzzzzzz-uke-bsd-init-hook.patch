+		extern void uke_last_log_hook_entry(const char *);
+		uke_usb_hook_entry("UKEUSB-HOOK-BSDINIT");
+		uke_last_log_hook_entry("UKELASTLOG-HOOK-BSDINIT");
+	}
 
 #if CONFIG_DEV_KMEM
 	bsd_init_kprintf("calling dev_kmem_init\n");
