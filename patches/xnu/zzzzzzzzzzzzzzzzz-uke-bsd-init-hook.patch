--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -506,6 +506,22 @@ bsd_init(void)
 	throttle_init();
 
 	printf(copyright);
+#if XNU_QCOM_USB_DEBUG
+	{
+		/* Board hooks that do not depend on the STARTUP() mechanism: this kernel has never shown a
+		 * line from the archive functions registered that way, while patched call sites
+		 * (uke-stage-last-panic, uke-heartbeat) are known to run.
+		 *
+		 * Guarded, not weak: a weak function reference still needs its pac-signed auth_ptr symbol
+		 * on arm64e, so the bootstrap pass - which links before the archive builders run - failed
+		 * with "_uke_usb_hook_entry ... l_uke_usb_hook_entry$auth_ptr$ia$". The guard is the same
+		 * one the component's own patches use: the bootstrap config leaves the macro 0. */
+		extern void uke_usb_hook_entry(const char *);
+		extern void uke_last_log_hook_entry(const char *);
+		uke_usb_hook_entry("UKEUSB-HOOK-BSDINIT");
+		uke_last_log_hook_entry("UKELASTLOG-HOOK-BSDINIT");
+	}
+#endif
 
 #if CONFIG_DEV_KMEM
 	bsd_init_kprintf("calling dev_kmem_init\n");
