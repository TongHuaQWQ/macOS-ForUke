--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -506,6 +506,24 @@ bsd_init(void)
 	throttle_init();
 
 	printf(copyright);
+	{
+		/* Board hooks that do not depend on the STARTUP() mechanism: this kernel has never shown a
+		 * line from the archive functions registered that way, while patched call sites
+		 * (uke-stage-last-panic, uke-heartbeat) are known to run.
+		 *
+		 * Weak, because the bootstrap pass links this kernel before the archive builders run: a
+		 * strong reference is an undefined symbol there, and the hook is only useful in the real
+		 * kernel anyway. Each hook writes its own pram beacon and, with uke_usb_hook=1, runs the
+		 * USB probe and freezes. */
+		extern void uke_usb_hook_entry(const char *) __attribute__((weak));
+		extern void uke_last_log_hook_entry(const char *) __attribute__((weak));
+		if (uke_usb_hook_entry != NULL) {
+			uke_usb_hook_entry("UKEUSB-HOOK-BSDINIT");
+		}
+		if (uke_last_log_hook_entry != NULL) {
+			uke_last_log_hook_entry("UKELASTLOG-HOOK-BSDINIT");
+		}
+	}
 
 #if CONFIG_DEV_KMEM
 	bsd_init_kprintf("calling dev_kmem_init\n");
