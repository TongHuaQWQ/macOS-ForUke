 static struct uke_diag_lane uke_diag_lanes[UKE_DIAG_MAX_CPU];
+
+/*
+ * uke-idle-guard: an idle CPU parks in machine_idle(), and with the timer live every one of its
+ * interrupts lands on the instruction just after the DAIF unmask there. To the sampler that looks like
+ * a perfect "same place" window, so an idle CPU would be reported as a hang. machine_idle() marks the
+ * CPU here; the sampler drops idle samples and clears the window.
+ */
+static volatile unsigned char uke_idle_cpu[UKE_DIAG_MAX_CPU];
+
+void
+uke_idle_enter(void)
+{
+	unsigned int cpu = (unsigned int)cpu_number();
+
+	if (cpu < UKE_DIAG_MAX_CPU) {
+		uke_idle_cpu[cpu] = 1;
+	}
+}
+
+void
+uke_idle_exit(void)
+{
+	unsigned int cpu = (unsigned int)cpu_number();
+
+	if (cpu < UKE_DIAG_MAX_CPU) {
+		uke_idle_cpu[cpu] = 0;
+	}
+}
+
+/* The gate probe sets this once kext startup begins; before that an idle CPU is expected. */
+static unsigned int uke_boot_stage;
+
+void
+uke_boot_stage_set(unsigned int stage)
+{
+	if (stage > uke_boot_stage) {
+		uke_boot_stage = stage;
+	}
+}
+
+unsigned int
+uke_boot_stage_get(void)
+{
+	return uke_boot_stage;
+}
