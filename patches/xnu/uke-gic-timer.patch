 	apt_msg_init_cpu();
 #endif
+#if DEVELOPMENT || DEBUG
+	/*
+	 * uke-gic: the virtual timer's PPI has to be enabled in this CPU's redistributor before the
+	 * interrupt below can ever arrive (see pexpert/arm/pe_init.c). Sits with fiq_context_init because
+	 * that is the call that turns the timer on.
+	 */
+	{
+		extern void uke_gic_start_cpu(void);
+		uke_gic_start_cpu();
+	}
+#endif /* DEVELOPMENT || DEBUG */
 	fiq_context_init(TRUE);
 
 
@@ -789,6 +800,12 @@
 #if __arm64__
 	apt_msg_init_cpu();
 #endif
+#if DEVELOPMENT || DEBUG
+	{
+		extern void uke_gic_start_cpu(void);
+		uke_gic_start_cpu();   /* uke-gic: this CPU's own redistributor, group and PPI 27 */
+	}
+#endif /* DEVELOPMENT || DEBUG */
 
 	fiq_context_init(TRUE);
 	cpu_data_ptr->rtcPop = EndOfAllTime;
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -3010,6 +3010,24 @@
 
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 
+#if DEVELOPMENT || DEBUG
+	/*
+	 * uke-gic: when the virtual timer's PPI 27 could only be put in group 1 (the distributor is in
+	 * two-security-state, so group 0 belongs to the secure side), it arrives here as an IRQ. Nothing
+	 * on this platform installs a registered interrupt handler, so cdp->interrupt_handler is NULL and
+	 * falling through would fault: take the timer ourselves and return.
+	 */
+	{
+		extern boolean_t uke_gic_timer_irq(void);
+
+		if (uke_gic_timer_irq()) {
+			entropy_collect();
+			sleh_interrupt_handler_epilogue();
+			return;
+		}
+	}
+#endif /* DEVELOPMENT || DEBUG */
+
 #if USE_APPLEARMSMP
 	PE_handle_ext_interrupt();
 #else
