+/*
+ * uke-aes-stub: AppleImage4's start waits without a timeout for a service of class IOAESAccelerator,
+ * and this collection has the class (IOCryptoAcceleratorFamily is prelinked) but no instance of it, so
+ * the wait never completes and the boot stops silently after the nonce magazine. Publishing an instance
+ * of the *original* class needs no vtable binding at all - unlike the NativeAES subclass, which is why
+ * SoftwareAES is off in this profile - so it is the cheapest way to find out whether the wait is only a
+ * matching problem. uke-aes-stub=1 enables it; off by default.
+ */
+static void
+fileset_wait_publish_aes_stub(const char * className)
+{
+	OSString * name;
+	OSObject * object;
+	IOService * service;
+
+	if (gUkeAesStubTried) {
+		return;
+	}
+	gUkeAesStubTried = true;
+
+	name = OSString::withCString(className);
+	if (name == NULL) {
+		return;
+	}
+	object = OSMetaClass::allocClassWithName(name);
+	name->release();
+	if (object == NULL) {
+		kprintf("uke-aes-stub: class %s is not registered\n", className);
+		return;
+	}
+	service = OSDynamicCast(IOService, object);
+	if ((service == NULL) || !service->init()) {
+		kprintf("uke-aes-stub: %s cannot be initialised\n", className);
+		object->release();
+		return;
+	}
+	if (!service->attach(IOService::getServiceRoot())) {
+		kprintf("uke-aes-stub: %s cannot be attached\n", className);
+		service->release();
+		return;
+	}
+	if (!service->registerService()) {
+		kprintf("uke-aes-stub: %s cannot be published\n", className);
+		service->detachAll(gIOServicePlane);
+		service->release();
+		return;
+	}
+	kprintf("uke-aes-stub: published %s at %p\n", className, service);
+}
