diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -550,9 +550,82 @@
 static void
 arm64_implementation_specific_error(arm_saved_state_t *state, uint64_t esr, vm_offset_t far)
 {
-#pragma unused (state, esr, far)
-	panic_plain("Unhandled implementation specific error\n");
-}
+	/*
+	 * uke-serror-detail: a photograph of "Unhandled implementation specific error" says nothing
+	 * about which fault it was, from where, or on which core, so every platform error on this
+	 * machine costs a flash and a photo and still ends in a guess. panic() stages its formatted
+	 * text into the pram panic header (uke-stage-last-panic), and the boot after this one reads
+	 * that header before anything else can scroll it away, so the report below survives a boot
+	 * whose screen never becomes legible.
+	 *
+	 * Reading the ESR: ec 0x24/0x25 is a data abort, whose iss carries the fault status code -
+	 * 0x10 is a synchronous external abort, meaning a device answered the access with an error
+	 * (bus timeout, gated block, unimplemented register), 0x11 is a parity or ECC error and
+	 * 0x21-0x23 are translation faults raised during a table walk. ec 0x2f is an SError taken on
+	 * this core, which is asynchronous and imprecise: far is then only a hint, so pc and lr are
+	 * what place it in the kernel.
+	 */
+	uint64_t uke_pc = (state != NULL) ? get_saved_state_pc(state) : 0;
+
+	/*
+	 * One line on purpose. The panel is the only console here and a photograph of it is the
+	 * read-out, so every field that survives has to earn its place: this is ~108 characters, which
+	 * fits a panel row and the 128-byte PanicLine the firmware shows in its menu. iss is dropped
+	 * because it is the low bits of esr (iss = esr & 0x1ffffff) and can be derived from it; lr, sp
+	 * and cpsr moved to the round notes because without the other fields they are unreadable.
+	 */
+	panic_plain("Unhandled platform error: esr 0x%016llx far 0x%016llx pc 0x%016llx "
+	    "ec 0x%02x cpu %u\n",
+	    (unsigned long long)esr, (unsigned long long)far, (unsigned long long)uke_pc,
+	    (unsigned int)ESR_EC(esr), (unsigned int)getCpuDatap()->cpu_id);
+}
+
+#if DEVELOPMENT || DEBUG
+/*
+ * uke-serror-resume: reports the same detail but does not stop the boot, for the case where the
+ * error comes from a device this port has no driver for rather than from something the kernel
+ * asked for. Only an asynchronous error is resumed (a synchronous one would re-execute the
+ * faulting instruction forever), only when the boot args ask for it - uke-serror-resume=N is both
+ * the switch and the number of resumptions tolerated, so a storm cannot hide the machine behind a
+ * console that never stops scrolling - and every resumption is staged into the pram record as
+ * well, so the boot after this one still names the fault even if its own screen stays black.
+ */
+static uint32_t uke_serror_resumes;
+
+static
+boolean_t
+__unused
+uke_serror_resume(arm_saved_state_t *state, uint64_t esr, vm_offset_t far,
+    platform_error_source_t source)
+{
+	extern int printf(const char *format, ...) __printflike(1, 2);
+	extern int snprintf(char *, size_t, const char *, ...) __printflike(3, 4);
+	extern boolean_t PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int max_arg);
+	extern void uke_stage_last_panic(const char *text) __attribute__((weak));
+	char text[192];
+	unsigned int allow = 0;
+
+	if (source != PLAT_ERR_SRC_ASYNC) {
+		return FALSE;
+	}
+	if (!PE_parse_boot_argn("uke-serror-resume", &allow, sizeof(allow)) || (allow == 0)) {
+		return FALSE;
+	}
+	if (uke_serror_resumes >= allow) {
+		return FALSE;
+	}
+	uke_serror_resumes++;
+	snprintf(text, sizeof(text), "uke-serror resumed %u/%u: esr 0x%llx far 0x%llx pc 0x%llx cpu %u",
+	    uke_serror_resumes, allow, (unsigned long long)esr, (unsigned long long)far,
+	    (unsigned long long)((state != NULL) ? get_saved_state_pc(state) : 0),
+	    (unsigned int)getCpuDatap()->cpu_id);
+	printf("%s\n", text);
+	if (uke_stage_last_panic != NULL) {
+		uke_stage_last_panic(text);
+	}
+	return TRUE;
+}
+#endif /* DEVELOPMENT || DEBUG */
 
 #if CONFIG_KERNEL_INTEGRITY
 #pragma clang diagnostic push
@@ -612,6 +685,11 @@
 	} else if (cdp->platform_error_handler != NULL) {
 		cdp->platform_error_handler(cdp->cpu_id, far);
 	} else {
+#if DEVELOPMENT || DEBUG
+		if (uke_serror_resume(state, esr, far, source)) {
+			return;
+		}
+#endif /* DEVELOPMENT || DEBUG */
 		arm64_implementation_specific_error(state, esr, far);
 	}
 }
