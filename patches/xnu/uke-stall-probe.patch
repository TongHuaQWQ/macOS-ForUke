+			extern uint64_t uke_diag_total_samples(void);
+			extern uint64_t uke_diag_last_pc(void);
+
+			printf("uke-stall-probe: samples=%llu last_pc=%#llx\n",
+			    (unsigned long long)uke_diag_total_samples(),
+			    (unsigned long long)uke_diag_last_pc());
+		}
