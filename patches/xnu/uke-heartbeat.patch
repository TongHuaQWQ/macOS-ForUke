@@ -448,6 +448,30 @@ void userServerAckTimerExpired(void *, void *);
 /* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
 
 void
+#if DEVELOPMENT || DEBUG
+/*
+ * uke-heartbeat: a kext that hangs silently and a console that stops refreshing look identical on
+ * the panel, which is exactly the ambiguity B12..B15 ran into: AppleImage4 prints twelve lines about
+ * its nonce magazine and then nothing changes. A line every two seconds from a thread call tells the
+ * two apart: heartbeats that keep appearing mean the kernel still runs and only the stuck thread is
+ * blocked, while no further heartbeat means the console itself stopped updating.
+ */
+static thread_call_t gUkeHeartbeatCall;
+
+static void
+ukeHeartbeat(thread_call_param_t p0, thread_call_param_t p1)
+{
+	static uint64_t beats;
+	uint64_t deadline;
+
+	beats++;
+	IOLog("uke-heartbeat %llu\n", beats);
+	if (clock_interval_to_deadline(2, 1000000000, &deadline) == KERN_SUCCESS) {
+		thread_call_enter_delayed(gUkeHeartbeatCall, deadline);
+	}
+}
+#endif /* DEVELOPMENT || DEBUG */
+
 IOService::initialize( void )
 {
 	kern_return_t       err;
@@ -489,6 +513,16 @@ IOService::initialize( void )
 	PE_parse_boot_argn("dextrelaunch", &gIODextRelaunchMax, sizeof(gIODextRelaunchMax));
 	PE_parse_boot_argn("iocthreads", &gMaxConfigThreads, sizeof(gMaxConfigThreads));
 
+#if DEVELOPMENT || DEBUG
+	gUkeHeartbeatCall = thread_call_allocate(ukeHeartbeat, NULL);
+	if (gUkeHeartbeatCall) {
+		uint64_t heartbeatDeadline;
+		if (clock_interval_to_deadline(2, 1000000000, &heartbeatDeadline) == KERN_SUCCESS) {
+			thread_call_enter_delayed(gUkeHeartbeatCall, heartbeatDeadline);
+		}
+	}
+#endif /* DEVELOPMENT || DEBUG */
+
 	gIOUserClientClassKey = OSSymbol::withCStringNoCopy( kIOUserClientClassKey );
 
 	gIOUserClassKey       = OSSymbol::withCStringNoCopy(kIOUserClassKey);
