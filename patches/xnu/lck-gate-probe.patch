 	return gate_close(gate);
@@ -3546,6 +3572,7 @@ lck_mtx_gate_close(__assert_only lck_mtx_t *lock, gate_t *gate)
 void
 lck_mtx_gate_open(__assert_only lck_mtx_t *lock, gate_t *gate)
 {
+	lck_gate_probe("open", lock, gate);
 	LCK_MTX_ASSERT(lock, LCK_MTX_ASSERT_OWNED);
 
 	gate_open(gate);
@@ -3579,6 +3606,7 @@ lck_mtx_gate_open(__assert_only lck_mtx_t *lock, gate_t *gate)
 kern_return_t
 lck_mtx_gate_handoff(__assert_only lck_mtx_t *lock, gate_t *gate, gate_handoff_flags_t flags)
 {
+	lck_gate_probe("handoff", lock, gate);
 	LCK_MTX_ASSERT(lock, LCK_MTX_ASSERT_OWNED);
 
 	return gate_handoff(gate, flags);
@@ -3606,6 +3634,7 @@ lck_mtx_gate_handoff(__assert_only lck_mtx_t *lock, gate_t *gate, gate_handoff_f
 void
 lck_mtx_gate_steal(__assert_only lck_mtx_t *lock, gate_t *gate)
 {
+	lck_gate_probe("steal", lock, gate);
 	LCK_MTX_ASSERT(lock, LCK_MTX_ASSERT_OWNED);
 
 	gate_steal(gate);
@@ -3640,6 +3669,7 @@ lck_mtx_gate_steal(__assert_only lck_mtx_t *lock, gate_t *gate)
 gate_wait_result_t
 lck_mtx_gate_wait(lck_mtx_t *lock, gate_t *gate, lck_sleep_action_t lck_sleep_action, wait_interrupt_t interruptible, uint64_t deadline)
 {
+	lck_gate_probe("wait", lock, gate);
 	LCK_MTX_ASSERT(lock, LCK_MTX_ASSERT_OWNED);
 
