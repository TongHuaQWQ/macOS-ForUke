--- a/osfmk/kern/locks.c
+++ b/osfmk/kern/locks.c
@@ -82,6 +82,26 @@
 
 #include <sys/kdebug.h>
 
+#if DEVELOPMENT || DEBUG
+/*
+ * lck-gate-probe: B14 showed AppleImage4 stopping with no output at all right after its nonce
+ * magazine reports "failed to read nonce slot data", and the next calls in that function are
+ * IOLockLock / lck_mtx_gate_close / IOLockUnlock (AppleImage4 0x958922c, +0x3d0 .. +0x3e0).
+ * Both can wait forever without printing: a mutex whose owner never releases it, and gate_ilock(),
+ * which spins on the gate's interlock bit with no timeout. Printing at the entry of every
+ * lck_mtx_gate_* call splits that window in one boot, and lock_mtx.c prints the contended mutex.
+ */
+extern int printf(const char *fmt, ...);
+#define LCK_GATE_PROBE(what, lock, gate) \
+	printf("lck-gate: %s lock=%p gate=%p data=%llx\n", (what), (void *)(lock), \
+	    (void *)(gate), (unsigned long long)((gate) ? (gate)->gt_data : 0))
+#define LCK_GATE_PROBE_LOCK(what, lock) \
+	printf("lck-gate: %s lock=%p\n", (what), (void *)(lock))
+#else
+#define LCK_GATE_PROBE(what, lock, gate)
+#define LCK_GATE_PROBE_LOCK(what, lock)
+#endif
+
 #define LCK_MTX_SLEEP_CODE              0
 #define LCK_MTX_SLEEP_DEADLINE_CODE     1
 #define LCK_MTX_LCK_WAIT_CODE           2
