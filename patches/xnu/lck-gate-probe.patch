  *   Arg2: pointer to the gate data declared with decl_lck_mtx_gate_data.
  */
 void
+#if DEVELOPMENT || DEBUG
+/*
+ * lck-gate-probe: B14 showed AppleImage4 stopping with no output at all right after its nonce
+ * magazine reports "failed to read nonce slot data", and the next calls in that function are
+ * IOLockLock / lck_mtx_gate_close / IOLockUnlock (AppleImage4 0x958922c, +0x3d0 .. +0x3e0). Both a
+ * mutex whose owner never releases it and gate_ilock() (a spin on the gate's interlock bit, no
+ * timeout) hang without printing anything, so one line per gate call says which half it is.
+ */
+static void
+lck_gate_probe(const char *what, lck_mtx_t *lock, gate_t *gate)
+{
+	extern int printf(const char *fmt, ...);
+
+	printf("lck-gate: %s lock=%p gate=%p data=%llx\n", what, (void *)lock, (void *)gate,
+	    (unsigned long long)(gate ? gate->gt_data : 0));
+}
+#else
+#define lck_gate_probe(what, lock, gate) do { } while (0)
+#endif
+
 lck_mtx_gate_init(lck_mtx_t *lock, gate_t *gate)
 {
+	lck_gate_probe("init", lock, gate);
 	(void) lock;
 	gate_init(gate, GT_INIT_DEFAULT);
 }
