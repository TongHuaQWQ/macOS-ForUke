diff --git a/osfmk/kern/locks.c b/osfmk/kern/locks.c
index 94a34dc..ff20b3e 100644
--- a/osfmk/kern/locks.c
+++ b/osfmk/kern/locks.c
@@ -3411,9 +3411,30 @@ lck_rw_gate_assert(__assert_only lck_rw_t *lock, gate_t *gate, gate_assert_flags
  *   Arg1: lck_mtx_t lock used to protect the gate.
  *   Arg2: pointer to the gate data declared with decl_lck_mtx_gate_data.
  */
+#if DEVELOPMENT || DEBUG
+/*
+ * lck-gate-probe: AppleImage4 stops with no output at all right after its nonce magazine reports
+ * "failed to read nonce slot data", and the next calls in that function are IOLockLock /
+ * lck_mtx_gate_close / IOLockUnlock (AppleImage4 0x958922c, +0x3d0 .. +0x3e0). Both a mutex whose
+ * owner never releases it and gate_ilock() (a spin on the gate's interlock bit with no timeout) hang
+ * without printing anything, so one line per gate call says which half of that window it is.
+ */
+static void
+lck_gate_probe(const char *what, lck_mtx_t *lock, gate_t *gate)
+{
+	extern int printf(const char *format, ...) __printflike(1, 2);
+
+	printf("lck-gate: %s lock=%p gate=%p data=%llx\n", what, (void *)lock, (void *)gate,
+	    (unsigned long long)(gate ? gate->gt_data : 0));
+}
+#else
+#define lck_gate_probe(what, lock, gate) do { } while (0)
+#endif
+
 void
 lck_mtx_gate_init(lck_mtx_t *lock, gate_t *gate)
 {
+	lck_gate_probe("init", lock, gate);
 	(void) lock;
 	gate_init(gate, GT_INIT_DEFAULT);
 }
@@ -3432,6 +3453,7 @@ lck_mtx_gate_init(lck_mtx_t *lock, gate_t *gate)
 gate_t*
 lck_mtx_gate_alloc_init(lck_mtx_t *lock)
 {
+	lck_gate_probe("alloc_init", lock, NULL);
 	(void) lock;
 	return gate_alloc_init();
 }
@@ -3449,6 +3471,7 @@ lck_mtx_gate_alloc_init(lck_mtx_t *lock)
 void
 lck_mtx_gate_destroy(lck_mtx_t *lock, gate_t *gate)
 {
+	lck_gate_probe("destroy", lock, gate);
 	(void) lock;
 	gate_destroy(gate);
 }
@@ -3468,6 +3491,7 @@ lck_mtx_gate_destroy(lck_mtx_t *lock, gate_t *gate)
 void
 lck_mtx_gate_free(lck_mtx_t *lock, gate_t *gate)
 {
+	lck_gate_probe("free", lock, gate);
 	(void) lock;
 	gate_free(gate);
 }
@@ -3501,6 +3525,7 @@ lck_mtx_gate_free(lck_mtx_t *lock, gate_t *gate)
 int
 lck_mtx_gate_try_close(__assert_only lck_mtx_t *lock, gate_t *gate)
 {
+	lck_gate_probe("try_close", lock, gate);
 	LCK_MTX_ASSERT(lock, LCK_MTX_ASSERT_OWNED);
 
 	return gate_try_close(gate);
@@ -3525,6 +3550,7 @@ lck_mtx_gate_try_close(__assert_only lck_mtx_t *lock, gate_t *gate)
