# Build outputs and caches (re-derivable; nothing important lives here)
/build/
/Build/
/Conf/
/out/
/.cache/
/refer/
/.local*/
/Mu_Basecore/

# Local development files
*.log
*.terminal
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc
*.dSYM/

# Inputs, images and products that never belong in Git
*.ipsw
*.dmg
*.im4p
*.img
*.dbr
*.macho
*.o
*.a
*.dylib
*.efi
*.dtb
# ...except the one the firmware build needs: Resources/Configs/uke.toml asks for append_dtb and
# build_uefi.py exits 1 without it. firmware/files/ is the patch set that reconstructs the firmware
# tree from a pristine upstream, so this copy has to travel with the repository.
!firmware/files/Resources/DTBs/uke.dtb
*.bc
*.spv
*.metallib
*.bin
*.mbn
*.fw
*.pem
*.key
.env
local.toml

# Local build inputs (unixnu.local.toml lives in the UniXNU checkout).
local.toml
