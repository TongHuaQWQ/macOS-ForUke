# uke first-console configuration WITHOUT the sheng legacy display provider.
#
# Why it exists: the display archive (build/native-legacy-display/
# libNativeLegacyDisplay.late.a) is gated by audit-mobile-graphics-legacy.py, which
# only accepts a candidate whose recorded original IOMobileFramebufferLegacy
# executable matches a previously qualified baseline. A kernel built by a different
# toolchain than the one that baseline came from can miss that gate, and then no
# kernel is produced at all.
#
# With XNU_NATIVE_LEGACY_DISPLAY unset, scripts/build-xnu-4k-baseline.sh inserts
# uke_display_probe_stub into bsd/init.c instead of requiring the archive, so the
# kernel links. The kernel then has no video console of its own, but the boot is
# still observable: DarwinBoot paints the green bar on the frame buffer and the
# entry probe (scripts/patch-xnu-entry-probe.py, applied by ./unixnu payload)
# paints the stage-1 blue and stage-2 magenta bands below it.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

# CONFIG_XNU_SOURCE_PTHREAD is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_AES is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_NATIVE_VIRTIO_CONSOLE is not set
# CONFIG_XNU_SHENG_PMGR is not set
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# CONFIG_XNU_OWNER_ROOT_AUDIT is not set
# CONFIG_XNU_OWNER_ROOT_TRUST is not set
# CONFIG_XNU_OWNER_CACHE_MOUNT is not set
# CONFIG_XNU_OWNER_CACHE_STARTUP is not set
# CONFIG_XNU_OWNER_BOOT_MANIFEST is not set
# CONFIG_XNU_OWNER_DATA_MOUNT is not set
# CONFIG_XNU_OWNER_UNION_SYSTEMOS is not set
# CONFIG_XNU_BOOT_PROGRESS is not set

CONFIG_XNU_OWNER_DATA_VOLUME_UUID="00000000-0000-0000-0000-000000000000"
