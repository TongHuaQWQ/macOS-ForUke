# uke macOS prelink configuration: everything the kernel needs to link and prelink, and nothing whose
# archive this port cannot build yet.
#
# Three switches differ from configs/uke-storage_defconfig. Each is off because the archive it
# selects cannot be built (or cannot be built correctly) for the macOS 26.5.2 train yet:
#
#   * CONFIG_XNU_NATIVE_UFS is off — the SangUfs component left [components] include: on arm64e it
#     delegates to build-sheng-source-storage.py, which authenticates every read against the OS
#     profile's signed root policy, and no policy exists for 25F84 yet.
#   * CONFIG_XNU_SHENG_PMGR is off — its archive comes from build-sheng-platform-power.py, which
#     inherits ApplePMGR slot addresses from an audit pinned to the iPadOS 17 kernelcache.
#   * CONFIG_XNU_NATIVE_AES is off — the NativeAES subclass derives from IOAESAccelerator, whose
#     methods live in the prelinked IOCryptoAcceleratorFamily, so its vtable can only be bound to a
#     measured address set. The one recorded set is scripts/data/native-aes-original-bindings.S,
#     measured on kernelcache.release.ipad7 (the iPadOS 17.7.11 image this board used to pin), and
#     prelink-ABI addresses do not carry across kernelcaches — board.toml now pins mac17g. Linking
#     that overlay anyway is what made run 41387605078 fail: libSoftwareAES.a(NativeAES.o) imports
#     IOAESAccelerator::createSpecialKeys/performAESQuantum/…, and the recorded overlay's own step
#     (build-software-aes-bindings.py) is not in board.toml's archive list, so nothing defined them.
#     With the switch off, build-xnu-4k-baseline.sh force-loads no libSoftwareAES.a and no object
#     references IOAESAccelerator::*. AES comes back with an audit of mac17g.
#
# What this configuration is for: building the comparison kernel and prelinking the real macOS
# collection into a kernel. Storage returns with the policy directory; the payload for this round is
# built with native-ufs-root=0.
#
# BUILD_ARCHIVES stays on: it is what lets board.toml [kernel] archives run, and
# build-fileset-release-reference.py is the last of those entries. component:SoftwareAES stays in that
# list too — it is what audits the subclass against the 26.5.2 headers — but its archive is not linked
# while the switch is off.
#
# Enabled (from uke-full_defconfig): SOURCE_PTHREAD, SOURCE_MOCKFS, BUILD_ARCHIVES.
#
# Left out on purpose:
#   * CONFIG_XNU_NATIVE_LEGACY_DISPLAY — its archive is gated by
#     audit-mobile-graphics-legacy.py, which only accepts a candidate matching a previously
#     qualified baseline (see configs/uke-nodisplay_defconfig). build-xnu-4k-baseline.sh then
#     inserts uke_display_probe_stub, and the panel keeps the DarwinBoot green bar plus the entry
#     probe's stage bands and the physical-framebuffer console from zzzzz-video-console-*.patch.
#   * CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE — a diagnostic, not needed to reach the root device.
#
# The GPU archives (Adreno740 and its kits, the Metal addon blob) also stay out: they need the
# A732 firmware pins in .cache/firmware/uke-gpu and the owner-built Metal plug-in, neither of which
# a public runner can produce. See the [kernel] archives comment in board.toml.

# Kernel configuration carried over from configs/uke-storage_defconfig.
#
# Everything here is reproducible from the pinned sources and the pinned
# kernelcache alone: the AES subclass is built but not linked (see the header),
# and NativeUfs is off entirely. CONFIG_XNU_BUILD_ARCHIVES makes the unixnu
# driver run the board archive list before the final link; the bootstrap pass
# and the first-console configurations leave it unset.
#
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_AES is not set
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# CONFIG_XNU_SHENG_PMGR is not set
CONFIG_XNU_DT_PANIC_REGION=y
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set

#
# Hardware-qualification gates, kept for configs/uke-full-plus_defconfig.
# Each one needs inputs that only a device run or the target-volume DMGs can
# produce, so they are deliberately not part of the reproducible full build:
#
#   NATIVE_VIRTIO_BLOCK / NATIVE_RAM_BLOCK
#       build/storage-abi/interface-audit.json needs a live guest snapshot
#       (gdb-stop.json) of the original IOBlockStorageDevice metadata.
#   VERIFIED_ROOT_PROBE / OWNER_ROOT_AUDIT / OWNER_ROOT_TRUST
#       need a signed policy bundle generated from the real OS/SystemOS DMGs.
#   OWNER_CACHE_* / OWNER_BOOT_MANIFEST / OWNER_DATA_MOUNT /
#   OWNER_UNION_SYSTEMOS
#       follow from the owner-root trust path.
#   BOOT_PROGRESS
#       the base build refuses it without the audited UFS/owner-root, VirtIO
#       and source-crypto set.
#   NATIVE_ADRENO
#       configs/uke-gpu_defconfig builds the A732 driver and generated GMU
#       headers. This stage-6 config keeps it off until the GPU path is
#       device-qualified.
#
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# CONFIG_XNU_OWNER_ROOT_AUDIT is not set
# CONFIG_XNU_OWNER_ROOT_TRUST is not set
# CONFIG_XNU_OWNER_CACHE_MOUNT is not set
# CONFIG_XNU_OWNER_CACHE_STARTUP is not set
# CONFIG_XNU_OWNER_BOOT_MANIFEST is not set
# CONFIG_XNU_OWNER_DATA_MOUNT is not set
# CONFIG_XNU_OWNER_UNION_SYSTEMOS is not set
# CONFIG_XNU_BOOT_PROGRESS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
