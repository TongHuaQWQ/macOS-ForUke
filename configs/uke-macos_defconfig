# uke macOS prelink configuration: everything the kernel needs to link and prelink, and nothing whose
# archive this port cannot build yet.
#
# Four switches differ from configs/uke-storage_defconfig. Three are off because the archive they
# select cannot be built (or cannot be built correctly) for the macOS 26.5.2 train yet:
#
#   * CONFIG_XNU_NATIVE_UFS is ON again since 2026-11-15: the blocker was that on arm64e the SangUfs
#     component delegates to build-sheng-source-storage.py, which authenticates every read against the
#     OS profile's signed root policy, and no policy existed. scripts/policies/26C5035r/{OS,SystemOS,App}
#     now holds all three, signed on an x86 Mac from the very images this board installs (each
#     verification.json records image_sha256 40d8282e…/14330ed9…/797bb1e0…, byte-identical to the
#     decrypted members in out/ipsw/26C5035r/, and original_image_modified false). The signed tables are
#     108.0 + 21.7 + 0.4 MiB, far larger than the 96 MiB boot partition, so board.toml sets
#     [root] tables_in_userdata and ships them as [userdata] objects "<window>.vroot"; the kernel bundle
#     carries only the 544-byte signed header of each.
#   * CONFIG_XNU_SHENG_PMGR is off — its archive comes from build-sheng-platform-power.py, which
#     inherits ApplePMGR slot addresses from an audit pinned to the iPadOS 17 kernelcache.
#   * CONFIG_XNU_NATIVE_AES is off — the NativeAES subclass derives from IOAESAccelerator, whose
#     methods live in the prelinked IOCryptoAcceleratorFamily, so its vtable can only be bound to a
#     measured address set. The one recorded set is scripts/data/native-aes-original-bindings.S,
#     measured on kernelcache.release.ipad7 (the iPadOS 17.7.11 image this board used to pin), and
#     prelink-ABI addresses do not carry across kernelcaches — board.toml now pins mac17g. Linking
#     that overlay anyway is what made run 41387605078 fail: libSoftwareAES.a(NativeAES.o) imports
#     IOAESAccelerator::createSpecialKeys/performAESQuantum/…, and the recorded overlay's own step
#     (build-software-aes-bindings.py) is not in board.toml's archive list, so nothing defined them.
#     With the switch off, build-xnu-4k-baseline.sh force-loads no libSoftwareAES.a and no object
#     references IOAESAccelerator::*. AES comes back with an audit of mac17g.
#   * CONFIG_XNU_CRYPTO_BOOTSTRAP is "source" instead of "prelinked" — see the note above that line.
#
# What this configuration is for: building the comparison kernel and prelinking the real macOS
# collection into a kernel. Storage returns with the policy directory; the payload for this round is
# built with native-ufs-root=0.
#
# BUILD_ARCHIVES stays on: it is what lets board.toml [kernel] archives run, and
# build-fileset-release-reference.py is the last of those entries. component:SoftwareAES stays in that
# list too — it is what audits the subclass against the 26.5.2 headers — but its archive is not linked
# while the switch is off.
#
# Enabled (from uke-full_defconfig): SOURCE_PTHREAD, SOURCE_MOCKFS, BUILD_ARCHIVES.
#
# Left out on purpose:
#   * CONFIG_XNU_NATIVE_LEGACY_DISPLAY — its archive is gated by
#     audit-mobile-graphics-legacy.py, which only accepts a candidate matching a previously
#     qualified baseline (see configs/uke-nodisplay_defconfig). build-xnu-4k-baseline.sh then
#     inserts uke_display_probe_stub, and the panel keeps the DarwinBoot green bar plus the entry
#     probe's stage bands and the physical-framebuffer console from zzzzz-video-console-*.patch.
#   * CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE — a diagnostic, not needed to reach the root device.
#
# The GPU archives (Adreno740 and its kits, the Metal addon blob) also stay out: they need the
# A732 firmware pins in .cache/firmware/uke-gpu and the owner-built Metal plug-in, neither of which
# a public runner can produce. See the [kernel] archives comment in board.toml.

# Kernel configuration carried over from configs/uke-storage_defconfig.
#
# Everything here is reproducible from the pinned sources and the pinned
# kernelcache alone: the AES subclass is built but not linked (see the header),
# and NativeUfs is off entirely. CONFIG_XNU_BUILD_ARCHIVES makes the unixnu
# driver run the board archive list before the final link; the bootstrap pass
# and the first-console configurations leave it unset.
#
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.

CONFIG_XNU_BUILD_ARCHIVES=y
# ROUND B experiment (branch round-b-lto): apple's kernelcache.release.* is an LTO build, and the
# fileset prelink pairs each kext call against our kernel by comparing code. A non-LTO reconstruction
# differs wherever Apple inlined, which is why the last full-closure report named only 1,508 of the
# 3,826 kext-facing targets. Watch `functions matched` and `kext-facing targets named` in the prelink
# log: they are directly comparable to the 8,781 / 1508 baseline (docs/11 §32.1).
CONFIG_XNU_BUILD_LTO=y
# NOT CONFIG_XNU_DEPLOYMENT_OS="macos" yet. The switch is real and wired, and it is the right direction
# -- Apple's macOS kernel is an XNU_TARGET_OS_OSX build, and those macros decide which code exists at
# all (docs/11 §34) -- but this tree is built with SDKROOT=iphoneos. Turning it on pulls in macOS-only
# kernel code (osfmk/vm/vm_compressor.c, vm_swap_file.c, vm_unix.c, vm_compressor_backing_store.c) whose
# identifiers the iphoneos SDK headers do not declare: 7 errors, one round (docs/11 §35). Doing this for
# real means a macOS-SDK kernel build (SDKROOT=macosx), which is a project of its own.
# CONFIG_XNU_DEPLOYMENT_OS="macos"
# Link the kernel the way a kernel *collection* needs it: `-Wl,-add_split_seg_info -Wl,-kernel`
# instead of the standalone `-fuse-ld=ld-classic -Wl,-threaded_starts_section` pair
# (patches/xnu-12377/arm64e-threaded-starts.patch switches on this define).
#
# Without it, emit_prelink.py dies in fileset_layout.split_references:
#   ValueError: Native image has no split-segment relocation information
# because a standalone link carries no LC_SEGMENT_SPLIT_INFO (0x1e), and the fileset emitter relocates
# the native kernel into the collection's __TEXT/__DATA ranges using exactly those records. The
# standalone pairing is what the boot-test configurations keep: arm_init rebases and signs
# __TEXT,__thread_starts itself, which only ld-classic emits.
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
# The SystemOS owner cache without the audited root trust path. This is the same bring-up escape hatch
# configs/uke-userland_defconfig uses, and it is what the kernel args already assume:
# native-ufs-root=1 and native-ufs-allow-unverified=1 are both in board.toml [payload] kernel_args.
# build-xnu-4k-baseline.sh:497 refuses OWNER_CACHE_MOUNT without OWNER_ROOT_TRUST, and :531 refuses
# OWNER_DATA_MOUNT without OWNER_BOOT_MANIFEST, unless this is on. Storage itself still authenticates
# every read: the policies are present, so build-sheng-source-storage.py takes its authenticated branch
# (vr_open against the 544-byte signed header, table from the "<window>.vroot" userdata object).
CONFIG_XNU_BRINGUP_OWNER_CACHE=y
# CONFIG_XNU_NATIVE_AES is not set   # sheng (iPadOS 26/27) never sets it either: SoftwareAES
# provides IOAESAccelerator through build-software-aes-bindings.py, and turning this on would only
# trip build-xnu-4k-baseline.sh's "requires the qualified original AES/crypto prelink closure"
# guard, whose condition is CRYPTO_BOOTSTRAP=prelinked, which this profile is not.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# CONFIG_XNU_SHENG_PMGR is not set
CONFIG_XNU_DT_PANIC_REGION=y
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set

#
# Hardware-qualification gates, kept for configs/uke-full-plus_defconfig.
# Each one needs inputs that only a device run or the target-volume DMGs can
# produce, so they are deliberately not part of the reproducible full build:
#
#   NATIVE_VIRTIO_BLOCK / NATIVE_RAM_BLOCK
#       build/storage-abi/interface-audit.json needs a live guest snapshot
#       (gdb-stop.json) of the original IOBlockStorageDevice metadata.
#   VERIFIED_ROOT_PROBE / OWNER_ROOT_AUDIT / OWNER_ROOT_TRUST
#       need a signed policy bundle generated from the real OS/SystemOS DMGs.
#   OWNER_CACHE_* / OWNER_BOOT_MANIFEST / OWNER_DATA_MOUNT /
#   OWNER_UNION_SYSTEMOS
#       follow from the owner-root trust path.
#   BOOT_PROGRESS
#       the base build refuses it without the audited UFS/owner-root, VirtIO
#       and source-crypto set.
#   NATIVE_ADRENO
#       configs/uke-gpu_defconfig builds the A732 driver and generated GMU
#       headers. This stage-6 config keeps it off until the GPU path is
#       device-qualified.
#
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# CONFIG_XNU_OWNER_ROOT_AUDIT is not set
# CONFIG_XNU_OWNER_ROOT_TRUST is not set
# The SystemOS owner cache and its union mount are ON for the storage round: the mount is what the APFS
# container failure was blocking on, and the policy directory now exists. The audited trust switches
# above stay off, which is why CONFIG_XNU_BRINGUP_OWNER_CACHE is on; VERIFIED_ROOT_PROBE additionally
# needs libVerifiedRootProbe.a, whose builder scripts/build-verified-root-probe.py is pinned to sheng's
# own 044-76034-038.dmg (expected_digest e5634d04…/b4908cde…, 1,483,785/806,400 blocks), so it would
# refuse this board's 40d8282e…/14330ed9… images; that generalisation is the root-trust milestone.
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
# No Data volume this round: the payload still has [payload.runtime] enabled = false, so no seed is
# installed and OWNER_DATA_MOUNT's build guard (requires OWNER_BOOT_MANIFEST) would demand one that
# cannot exist yet. The seed identity is recorded below so the next round has one place to read it.
# CONFIG_XNU_OWNER_BOOT_MANIFEST is not set
# CONFIG_XNU_OWNER_DATA_MOUNT is not set
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# CONFIG_XNU_BOOT_PROGRESS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set

# `source`, not `prelinked`. The source provider is what the collection case is written for:
# patches/xnu-12377/source-corecrypto14-bootstrap.patch starts the original com.apple.kec.corecrypto
# *out of the boot kernel collection* before anything needs crypto and lets OSKext's later start of
# that module return the same result, so there is exactly one provider ("Registering two providers
# would leave the second one's PRNG context uninitialized"). `prelinked` does the opposite: it drops
# the provider definitions with -UXNU_SOURCE_CORECRYPTO14 in prng_random.o, and with them the FIPS
# POST object the kernel otherwise carries — run 41403174431 died in emit_prelink with
#   ValueError: Expected one 32-byte corecrypto HMAC field
# because fileset_segmented.patch_entry_header() reseals `__TEXT,__fips_hmacs` over the relocated
# __TEXT_EXEC,__text, and `prelinked` leaves no such section to reseal. The same switch is what the
# iOS 26/27 boards set (UniXNU-sheng: CONFIG_XNU_CRYPTO_BOOTSTRAP="source").
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
# The APFS volume UUID of this port's first-install Data seed, made on the x86 Mac from the decrypted OS
# image (out/uke/macos-27.3-uke/uke-macos/runtime/data.dbr, 22,614,176 B packed, 210 GiB container,
# encoded_sha256 a43d3ee0…80924). scripts/unixnu/runtime.py:110 compares it with the seed's own UUID and
# :118 demands exactly one match in the configuration; build-xnu-4k-baseline.sh only compiles it into
# owner-data-volume.h when OWNER_DATA_MOUNT and NATIVE_RAM_BLOCK are both on, so with them off this line
# documents the seed identity and nothing reads it yet. It is not the root/cache/app UUIDs: those are
# properties of Apple's signed images and live in board.toml [root].
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="BB2462E2-040E-4F82-9C69-CACB7A872551"
# CONFIG_XNU_BOOT_LOG links build/uke-last-log/libUkeLastLog.a with -force_load, which is
# what makes the pram writer exist in the kernel at all: build-boot-log.py only *builds* the
# archive, and build-xnu-4k-baseline.sh adds it to LD_KERNEL_ARCHIVES on BOOT_LOG=1 or
# WATCHDOG_POLICY=1. Without this switch the archive was never linked (b56/b58 carry no
# UkeLastLog string at all), so the msgbuf -> pram path did not exist even though sheng-log=1
# was in kernel_args.
CONFIG_XNU_BOOT_LOG=y
# The second half of the log survives a reset: every two seconds the same writer appends a 16 KiB
# record to the last 32 MiB of userdata (UKELLOG1 magic, sequence, CRC), which TWRP can read with dd
# without a second boot and without losing the start of the boot to the ring. Without this switch
# UkeLastLog.c compiles the pram half only, which is what every earlier round did -- the window was
# verified zero-filled because the writer was never in the image.
#
# The symbols it needs are not NativeUfs's: build-ufs-log.py builds package/UfsLog.cpp (the driver's
# IOKit-free transport: request list, SCSI layer, SMMU takeover, NOP OUT) and package/UfsLogKernel.c
# (register windows, one contiguous DMA area, one lock) into libUkeUfsLog.a, and
# CONFIG_XNU_EXTRA_LD_ARCHIVES force-loads it below. The window's geometry arrives on the command line
# as uke-log-first/uke-log-last (board.toml [payload] kernel_args).
CONFIG_XNU_LOG_USERDATA=y
# The USB log console (package/qcom-usb-debug): the component's darwin24 pair stays in the series (rebased
# onto xnu-12377.121.6, see package/qcom-usb-debug/patches/darwin24/README.md) and build-qcom-usb-debug.py
# still builds the archive from board.toml [kernel] archives -- but it is NOT linked, and this key is what
# links it: build-xnu-4k-baseline.sh force-loads .cache/qcom-usb-debug/libQcomXnuUsbDebug.a when
# XNU_QCOM_USB_DEBUG=1 and compiles the series' hooks with -DXNU_QCOM_USB_DEBUG=0 when it is 0.
# Off because this round runs the official route instead (drivers/QcomDwc3): both drive the same DWC3 and
# package/QcomRpmh.c duplicates this component's soc/QcomRpmh.c, so only one may be in a kernel. The
# patch series still applies unchanged, the hooks compile to nothing, and re-enabling the console is this
# one line plus the three boot arguments named at the usb=1 block in board.toml.
CONFIG_XNU_QCOM_USB_DEBUG=n
# Force-loaded straight into the kernel link (build-xnu-4k-baseline.sh appends XNU_EXTRA_LD_ARCHIVES
# verbatim, so the -force_load comes from here). {tree} is the build tree, which is also what the
# script's $ROOT is -- the same substitution uke-full-plus_defconfig's two *_ARCHIVE keys use.
#
# The first two archives stay linked, and no configuration decides which one wins. package/UfsLog.cpp exports
# native_ufs_log_open/write/sync WEAK since this round; the storage archive carries
# drivers/ShengUfs/NativeUfs.cpp (build-sheng-source-storage.py:202), which defines the same three
# strongly. A strong definition beats a weak one, so with CONFIG_XNU_NATIVE_UFS on the driver serves
# the log (real UFS controller, forced unit access) and with it off the freestanding transport is the
# only definition and still applies. Before this, two -force_loads with two strong definitions would
# have been a duplicate symbol at the link. The same weak-fallback pattern is used in
# package/GpuPowerProbe.cpp:73-88 and by build-sheng-source-storage.py's weak_defaults().
# The second archive is what package/SourceStorage.cpp needs: it publishes SoftwareAES itself
# (source_software_aes_init / native_software_aes_create / native_aes_kat_status...), unconditionally, so the
# source storage runtime cannot link without it. The archive is already built in this configuration --
# board.toml [kernel] archives runs build-software-aes-bindings.py, whose default output is
# build/software-aes/libSoftwareAES.a -- it was simply never force-loaded. Allenwdk/UniXNU-uke lists its
# equivalent (build/software-aes-27/libSoftwareAES27.a) in the same key for the same reason. This is NOT
# CONFIG_XNU_NATIVE_AES: that switch would also turn on the NativeAES subclass path whose vtable binding
# this configuration deliberately leaves alone (see the note above).
# The third archive is the official USB route (drivers/QcomDwc3, scripts/build-qcom-dwc3.py): QcomDwc3Xdci
# and QcomDwc3Xhci subclass Apple's private AppleUSBXDCI/AppleUSBXHCI, and the kernel's only reference to
# uke_usb_probe lives behind the XNU patch series (patches/xnu/zzzzzzzzzzzzzzzzzzz-uke-usb-start.patch calls
# it from bsd_autoconf()), so -force_load keeps every object in the image; whether it runs is decided at
# boot by `usb=` (board.toml [payload] kernel_args), not by the link.
#
# Only ONE of the two USB owners may be in this list. drivers/QcomDwc3, package/qcom-usb-debug
# (libQcomXnuUsbDebug.a) and package/uke_usb.c all program the same DWC3, and package/QcomRpmh.c is a
# byte-identical copy of package/qcom-usb-debug/soc/QcomRpmh.c, so two of them in one link is both a
# controller fight and a duplicate symbol. This configuration therefore carries libQcomDwc3.a and leaves
# CONFIG_XNU_QCOM_USB_DEBUG=n: board.toml [kernel] archives still runs build-qcom-usb-debug.py, so the
# CDC-ACM console stays buildable (bash package/qcom-usb-debug/scripts/check-component.sh --fast proves it
# in seconds), it is simply not linked. Flipping back is this key plus the three boot arguments named at
# the usb=1 block in board.toml.
# The fourth archive is Qualcomm WCN6750 Bluetooth (drivers/QcaBluetooth + SM7675 UART10 + WcnPower +
# BluetoothProbe, built by scripts/build-qca-bluetooth.py). Started from bsd_autoconf() by
# patches/xnu/zzzzzzzzzzzzzzzzzzzz-uke-bluetooth-start.patch (gated by `bluetooth=1` in kernel_args);
# BluetoothFirmware.c is already compiled into libShengUfs.a by build-sheng-source-storage.py.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/uke-ufs-log/libUkeUfsLog.a -Wl,-force_load,{tree}/build/software-aes/libSoftwareAES.a -Wl,-force_load,{tree}/build/qcom-dwc3/libQcomDwc3.a -Wl,-force_load,{tree}/build/qca-bluetooth/libQcaBluetooth.a"
# The source storage runtime and where its root-policy tables travel. These keys are the official ones —
# Allenwdk/UniXNU-uke sets exactly this set for this device (configs/uke_ipados27_defconfig:20-23) — and
# they reach the scripts through xnu_env(), which turns every CONFIG_XNU_* into the XNU_* variable of the
# same name:
#
#   * XNU_SOURCE_STORAGE=1 declares the arm64e source runtime, so the build's own guards accept this
#     archive set (build-xnu-4k-baseline.sh:247/323/333/758 are the four refusals that key on it).
#   * XNU_SOURCE_STORAGE_TABLES=userdata is what makes build-sheng-source-storage.py ship the 544-byte
#     signed header instead of the full manifest: the OS table alone is 108 MiB against a 96 MiB
#     vendor_boot. The tables arrive as the [userdata] objects "<window>.vroot". board.toml also carries
#     [root] tables_in_userdata, which sets the very same variable — the board key is the newer, more
#     explicit spelling, and the two agree by construction.
#   * XNU_SOURCE_STORAGE_POLICIES lists the windows that have a policy directory. macOS has three: the OS
#     volume, the SystemOS cryptex and the App cryptex.
#
# What this does NOT change is the link: CONFIG_XNU_NATIVE_UFS above already makes
# build-xnu-4k-baseline.sh:678-683 force-load $ROOT/build/sheng-ufs/libShengUfs.a, and
# build-sheng-source-storage.py copies the archive it builds to exactly that path ("Keep the catalog's
# archive output stable for the resolved-tree copier"). So libShengSourceStorage.a must NOT be added to
# XNU_EXTRA_LD_ARCHIVES here: the same archive would be force-loaded twice and every symbol in it would
# collide. Allenwdk's defconfig lists it because that board leaves NATIVE_UFS off and gets the archive
# only that way.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_SOURCE_STORAGE_TABLES="userdata"
CONFIG_XNU_SOURCE_STORAGE_POLICIES="OS,SystemOS,App"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
